    def wait_for_usage_report(
        self,
        report_id: str,
        *,
        timeout_seconds: int = DEFAULT_REPORT_TIMEOUT_SECONDS,
        poll_interval_seconds: int = DEFAULT_REPORT_POLL_SECONDS,
    ) -> dict[str, Any]:
        if timeout_seconds <= 0:
            raise ValueError("timeout_seconds must be positive")
        if poll_interval_seconds <= 0:
            raise ValueError("poll_interval_seconds must be positive")
        if self.config.dry_run:
            return self.get_usage_report(report_id)
        deadline = time.monotonic() + timeout_seconds
        while time.monotonic() < deadline:
            last = self.get_usage_report(report_id)
            status = str(last.get("status", "")).lower()
            if status in {"completed", "ready", "done"}:
                return last
            if status in {"failed", "error", "cancelled"}:
                raise RuntimeError(
                    f"Usage report {report_id} ended with status {status!r}: "
                    f"{first_present(last, ('message', 'error'), 'no error details')}"
                )
            time.sleep(poll_interval_seconds)
        raise RuntimeError(
            f"Timed out after {timeout_seconds} seconds waiting for usage report {report_id}"
        )

    def get_or_create_usage_report(
        self,
        *,
        report_type: str,
        start_date: str,
        end_date: str,
        timeout_seconds: int = DEFAULT_REPORT_TIMEOUT_SECONDS,
        poll_interval_seconds: int = DEFAULT_REPORT_POLL_SECONDS,
    ) -> dict[str, Any]:
        existing_data = self.list_usage_reports()
        existing_reports = (
            existing_data.get("usage_report_exports", [])
            if isinstance(existing_data, dict)
            else []
        )
        matching = [
            item
            for item in existing_reports
            if isinstance(item, dict)
            and item.get("report_type") == report_type
            and item.get("start_date") == start_date
            and item.get("end_date") == end_date
        ]
        matching.sort(key=lambda item: str(item.get("created_at") or ""), reverse=True)
        completed = [
            item
            for item in matching
            if str(item.get("status") or "").casefold() in {"completed", "ready", "done"}
            and item.get("download_urls")
        ]
        if completed:
            return completed[0]

        processing = [
            item
            for item in matching
            if str(item.get("status") or "").casefold()
            not in {"failed", "error", "cancelled", "completed", "ready", "done"}
        ]
        if processing:
            report_id = str(processing[0].get("id") or "")
        else:
            try:
                created = self.create_usage_report(
                    report_type=report_type,
                    start_date=start_date,
                    end_date=end_date,
                    send_email=False,
                )
            except GitHubApiError as exc:
                if exc.status_code != 400 or "progress" not in exc.message.casefold():
                    raise
                refreshed = self.list_usage_reports()
                refreshed_reports = (
                    refreshed.get("usage_report_exports", [])
                    if isinstance(refreshed, dict)
                    else []
                )
                processing = [
                    item
                    for item in refreshed_reports
                    if isinstance(item, dict)
                    and item.get("report_type") == report_type
                    and item.get("start_date") == start_date
                    and item.get("end_date") == end_date
                    and str(item.get("status") or "").casefold()
                    not in {"failed", "error", "cancelled", "completed", "ready", "done"}
                ]
                if not processing:
                    raise RuntimeError(
                        "GitHub reported a usage export in progress, but no reusable export was listed"
                    ) from exc
                processing.sort(key=lambda item: str(item.get("created_at") or ""), reverse=True)
                report_id = str(processing[0].get("id") or "")
            else:
                report_id = str(created.get("id") or created.get("report_id") or "")
                if self.config.dry_run:
                    return created

        if not report_id:
            raise RuntimeError("GitHub did not return a usage report ID")
        final = self.wait_for_usage_report(
            report_id,
            timeout_seconds=timeout_seconds,
            poll_interval_seconds=poll_interval_seconds,
        )
        download_urls = final.get("download_urls") or final.get("downloadUrls")
        if not isinstance(download_urls, list) or not download_urls:
            raise RuntimeError(f"Completed usage report {report_id} has no download URLs")
        return final

    def download_usage_report_csv(self, download_urls: list[str]) -> list[dict[str, Any]]:
        if self.config.dry_run:
            return []
        rows: list[dict[str, Any]] = []
        for url in download_urls:
            if not isinstance(url, str) or not url.startswith("https://"):
                raise RuntimeError("GitHub returned an invalid non-HTTPS usage-report download URL")
            response = self.session.get(url, timeout=self.config.timeout)
            response.raise_for_status()
            reader = csv.DictReader(io.StringIO(response.text))
            rows.extend(dict(row) for row in reader)
        return rows

