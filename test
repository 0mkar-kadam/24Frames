    def build_all_users_budget_consumption(
        self,
        *,
        usage_source: str,
        start_date: str | None,
        end_date: str | None,
        year: int | None,
        month: int | None,
        day: int | None,
        report_timeout_seconds: int = DEFAULT_REPORT_TIMEOUT_SECONDS,
        report_poll_seconds: int = DEFAULT_REPORT_POLL_SECONDS,
    ) -> dict[str, Any]:
        if usage_source not in {"report", "none"}:
            raise ValueError(
                "usage_source must be report or none; GitHub's direct enterprise "
                "AI-credit endpoint is aggregate-only and cannot build per-user rows"
            )
        if usage_source == "none" and any(
            value is not None for value in (start_date, end_date, year, month, day)
        ):
            raise ValueError("Date filters require --usage-source report")

        seats = self.list_enterprise_copilot_seats(all_pages=True)
        budgets = self.list_budgets(scope="user", all_pages=True)
        usage_by_user: dict[str, dict[str, Any]] = {}
        usage_metadata: dict[str, Any] = {"usage_source": usage_source}

        if usage_source == "report":
            start_date, end_date = resolve_ai_credit_report_range(
                start_date=start_date,
                end_date=end_date,
                year=year,
                month=month,
                day=day,
            )
            final_report = self.get_or_create_usage_report(
                report_type="ai_credit",
                start_date=start_date,
                end_date=end_date,
                timeout_seconds=report_timeout_seconds,
                poll_interval_seconds=report_poll_seconds,
            )
            report_id = final_report.get("id") or final_report.get("report_id") or "dry-run-report-id"
            download_urls = final_report.get("download_urls") or final_report.get("downloadUrls") or []
            rows = self.download_usage_report_csv(download_urls if isinstance(download_urls, list) else [download_urls])
            usage_by_user = aggregate_usage_items_by_user(rows)
            usage_metadata.update(
                {
                    "report_id": report_id,
                    "report_status": final_report.get("status"),
                    "downloaded_rows": len(rows),
                    "start_date": start_date,
                    "end_date": end_date,
                }
            )
            if self.config.dry_run:
                usage_metadata["planned_requests"] = {
                    "copilot_seats": {
                        "method": "GET",
                        "endpoint": (
                            f"/enterprises/{self._enterprise_slug()}/copilot/billing/seats"
                        ),
                        "params": {"page": 1, "per_page": 100},
                        "source": DOCS_COPILOT_SEATS,
                    },
                    "user_budgets": {
                        "method": "GET",
                        "endpoint": self._owner_budget_endpoint("enterprise"),
                        "params": {"scope": "user", "page": 1, "per_page": 100},
                        "source": DOCS_BUDGETS,
                    },
                    "usage_report": (
                        final_report.get("request")
                        or (
                            final_report
                            if final_report.get("dry_run") is True
                            else None
                        )
                    ),
                }

        budgets_by_user: dict[str, list[dict[str, Any]]] = {}
        for budget in budgets.get("budgets", []):
            if (
                not isinstance(budget, dict)
                or budget.get("budget_scope") != "user"
                or budget.get("budget_type") != "BundlePricing"
                or not budget_has_sku(budget, "ai_credits")
            ):
                continue
            user = normalize_login(first_present(budget, ("user", "budget_entity_name"), ""))
            if user:
                budgets_by_user.setdefault(user, []).append(budget)

        report_errors: list[dict[str, Any]] = []
        budget_by_user: dict[str, dict[str, Any]] = {}
        for user, matching_budgets in budgets_by_user.items():
            budget_by_user[user] = matching_budgets[0]
            if len(matching_budgets) > 1:
                report_errors.append(
                    {
                        "user": user,
                        "operation": "select_ai_credit_user_budget",
                        "error_type": "AmbiguousBudget",
                        "error": (
                            f"{len(matching_budgets)} bundled AI-credit user budgets matched; "
                            "the first row is shown and the workbook is marked incomplete"
                        ),
                        "budget_ids": [
                            str(item.get("id") or "") for item in matching_budgets
                        ],
                    }
                )

        users: dict[str, dict[str, Any]] = {}
        for seat in seats.get("seats", []):
            assignee = seat.get("assignee") if isinstance(seat.get("assignee"), dict) else {}
            login = normalize_login(assignee.get("login") or seat.get("login"))
            if not login:
                continue
            users[login] = {
                "user": login,
                "email": extract_user_email(assignee) or extract_user_email(seat),
                "has_copilot_seat": True,
                "copilot_plan_type": seat.get("plan_type"),
                "last_activity_at": seat.get("last_activity_at"),
                "last_authenticated_at": seat.get("last_authenticated_at"),
            }
        for login, budget in budget_by_user.items():
            user_row = users.setdefault(login, {"user": login, "has_copilot_seat": False})
            if not user_row.get("email"):
                user_row["email"] = extract_user_email(budget)
        for login, usage in usage_by_user.items():
            user_row = users.setdefault(login, {"user": login, "has_copilot_seat": False})
            if not user_row.get("email"):
                user_row["email"] = extract_user_email(usage)

        rows_out: list[dict[str, Any]] = []
        for login in sorted(users):
            base = users[login]
            budget = budget_by_user.get(login)
            budget_count = len(budgets_by_user.get(login, []))
            usage = usage_by_user.get(login, {})
            budget_amount = safe_float(budget.get("budget_amount")) if budget else None
            consumed_amount = safe_float(budget.get("consumed_amount")) if budget else None
            gross_usage = safe_float(usage.get("gross_amount")) or 0.0
            gross_quantity = safe_float(usage.get("gross_quantity")) or 0.0
            net_quantity = safe_float(usage.get("net_quantity")) or 0.0
            discount_quantity = safe_float(usage.get("discount_quantity")) or 0.0
            effective_used = consumed_amount if consumed_amount is not None else gross_usage
            usage_source_value = usage.get("usage_source")
            if not usage_source_value and consumed_amount is not None:
                usage_source_value = "budget_api"
            elif not usage_source_value:
                usage_source_value = "no_usage_found"
            rows_out.append(
                {
                    "user": login,
                    "email": base.get("email") or extract_user_email(usage) or extract_user_email(budget or {}) or None,
                    "has_copilot_seat": base.get("has_copilot_seat", False),
                    "has_budget": bool(budget),
                    "matching_budget_count": budget_count,
                    "budget_ambiguous": budget_count > 1,
                    "budget_id": budget.get("id") if budget else None,
                    "budget_amount": budget_amount,
                    "budget_consumed_amount": consumed_amount,
                    "budget_remaining": (
                        round(budget_amount - consumed_amount, 2)
                        if budget_amount is not None and consumed_amount is not None
                        else None
                    ),
                    "consumption_pct": (
                        round((consumed_amount / budget_amount) * 100, 2)
                        if budget_amount and consumed_amount is not None
                        else None
                    ),
                    "prevent_further_usage": budget.get("prevent_further_usage") if budget else None,
                    "budget_type": budget.get("budget_type") if budget else None,
                    "budget_product_sku": (
                        first_present(
                            budget,
                            ("budget_product_sku", "budget_product_skus"),
                        )
                        if budget
                        else None
                    ),
                    "usage_source": usage_source_value,
                    "ai_credits_used": gross_quantity,
                    "net_ai_credits": net_quantity,
                    "discounted_ai_credits": discount_quantity,
                    "gross_usage_usd": gross_usage,
                    "net_usage_usd": safe_float(usage.get("net_amount")) or 0.0,
                    "discount_usage_usd": safe_float(usage.get("discount_amount")) or 0.0,
                    "effective_used_usd": effective_used,
                    "copilot_plan_type": base.get("copilot_plan_type"),
                    "last_activity_at": base.get("last_activity_at"),
                    "last_authenticated_at": base.get("last_authenticated_at"),
                }
            )

        summary = {
            "total_users": len(rows_out),
            "budgeted_users": sum(1 for row in rows_out if row["has_budget"]),
            "non_budgeted_users": sum(1 for row in rows_out if not row["has_budget"]),
            "non_budgeted_users_with_usage": sum(
                1
                for row in rows_out
                if not row["has_budget"] and safe_float(row.get("gross_usage_usd")) not in (None, 0.0)
            ),
            "usage_metadata": usage_metadata,
            "generated_at": datetime.now(timezone.utc).isoformat(),
        }
        return {
            "ok": not report_errors,
            "Summary": {
                key: value for key, value in summary.items() if key != "usage_metadata"
            },
            "Users": rows_out,
            "Usage Metadata": usage_metadata,
            "Errors": report_errors,
        }

    def build_cost_centers_report(
        self,
        *,
        state: str = "active",
        include_usage: bool = False,
    ) -> dict[str, Any]:
        if state == "all":
            cost_centers = []
            seen_cost_center_ids: set[str] = set()
            for requested_state in ("active", "deleted"):
                for item in extract_cost_centers(
                    self.list_cost_centers(state=requested_state)
                ):
                    item_id = str(item.get("id") or "")
                    dedupe_key = item_id or compact_json(item)
                    if dedupe_key in seen_cost_center_ids:
                        continue
                    seen_cost_center_ids.add(dedupe_key)
                    cost_centers.append(item)
        elif state in VALID_COST_CENTER_STATES:
            cost_centers = extract_cost_centers(self.list_cost_centers(state=state))
        else:
            raise ValueError("state must be active, deleted, or all")
        budgets = self.list_budgets(scope="cost_center", all_pages=True)
        budget_items = budgets.get("budgets", [])

        cost_center_rows: list[dict[str, Any]] = []
        resource_rows: list[dict[str, Any]] = []
        budget_rows: list[dict[str, Any]] = []
        usage_rows: list[dict[str, Any]] = []
        usage_metadata_rows: list[dict[str, Any]] = []
        errors: list[dict[str, Any]] = []
        for cost_center in cost_centers:
            cost_center_id = str(cost_center.get("id") or "")
            try:
                details = self.get_cost_center(cost_center_id) if cost_center_id else cost_center
            except (GitHubApiError, requests.RequestException, ValueError, RuntimeError) as exc:
                details = cost_center
                errors.append(
                    {
                        "cost_center_id": cost_center_id,
                        "cost_center_name": cost_center.get("name"),
                        "operation": "get_cost_center_details",
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )
            resources = details.get("resources", []) if isinstance(details, dict) else []
            name = str(first_present(details, ("name",), cost_center.get("name") or ""))
            matching_budgets = [
                budget
                for budget in budget_items
                if isinstance(budget, dict)
                and budget.get("budget_scope") == "cost_center"
                and budget_entity_matches(
                    budget,
                    cost_center_id=cost_center_id,
                    cost_center_name=name,
                )
            ]
            ai_budgets = [
                budget
                for budget in matching_budgets
                if budget.get("budget_type") == "BundlePricing"
                and budget_has_sku(budget, "ai_credits")
            ]
            ai_budget = ai_budgets[0] if ai_budgets else None
            if len(ai_budgets) > 1:
                errors.append(
                    {
                        "cost_center_id": cost_center_id,
                        "cost_center_name": name,
                        "operation": "select_ai_credit_cost_center_budget",
                        "error_type": "AmbiguousBudget",
                        "error": (
                            f"{len(ai_budgets)} bundled AI-credit cost-center "
                            "budgets matched; the first row is shown and the "
                            "workbook is marked incomplete"
                        ),
                        "budget_ids": [
                            str(item.get("id") or "") for item in ai_budgets
                        ],
                    }
                )
            resource_counts = cost_center_resources_by_payload_key(resources)
            pool_state = details.get("ai_credit_pool_state") if isinstance(details, dict) else {}
            if not isinstance(pool_state, dict):
                pool_state = {}
            alerting = ai_budget.get("budget_alerting") if ai_budget else {}
            if not isinstance(alerting, dict):
                alerting = {}

            usage_agg = aggregate_usage_items([])
            if include_usage and cost_center_id:
                try:
                    usage = self.get_enterprise_ai_credit_usage(cost_center_id=cost_center_id)
                    items = usage.get("usageItems", []) if isinstance(usage, dict) else []
                    usage_agg = aggregate_usage_items(items)
                    usage_metadata_rows.append(
                        {
                            "cost_center_id": cost_center_id,
                            "cost_center_name": name,
                            "time_period": (
                                first_present(
                                    usage,
                                    ("timePeriod", "time_period"),
                                )
                                if isinstance(usage, dict)
                                else None
                            ),
                            "usage_items": len(items),
                            "retrieved_at": datetime.now(timezone.utc).isoformat(),
                        }
                    )
                    for item in items:
                        if not isinstance(item, dict):
                            continue
                        usage_rows.append(
                            {
                                "cost_center_id": cost_center_id,
                                "cost_center_name": name,
                                **item,
                            }
                        )
                except (GitHubApiError, requests.RequestException, ValueError, RuntimeError) as exc:
                    errors.append(
                        {
                            "cost_center_id": cost_center_id,
                            "cost_center_name": name,
                            "operation": "get_cost_center_ai_usage",
                            "error_type": type(exc).__name__,
                            "error": str(exc),
                        }
                    )

            cost_center_rows.append(
                {
                    "cost_center_id": cost_center_id,
                    "name": name,
                    "state": first_present(details, ("state", "costCenterState"), cost_center.get("state")),
                    "azure_subscription": details.get("azure_subscription") if isinstance(details, dict) else None,
                    "ai_credit_pool_enabled": details.get("ai_credit_pool_enabled") if isinstance(details, dict) else None,
                    "ai_credit_pool_target_amount": safe_float(pool_state.get("target_amount")),
                    "ai_credit_pool_current_amount": safe_float(pool_state.get("current_amount")),
                    "resource_count": len(resources),
                    "user_count": len(resource_counts["users"]),
                    "organization_count": len(resource_counts["organizations"]),
                    "repository_count": len(resource_counts["repositories"]),
                    "enterprise_team_count": len(resource_counts["enterprise_teams"]),
                    "budget_count": len(matching_budgets),
                    "matching_ai_credit_budget_count": len(ai_budgets),
                    "ai_credit_budget_ambiguous": len(ai_budgets) > 1,
                    "ai_credit_budget_id": ai_budget.get("id") if ai_budget else None,
                    "ai_credit_budget_amount": safe_float(ai_budget.get("budget_amount")) if ai_budget else None,
                    "ai_credit_budget_consumed_amount": safe_float(ai_budget.get("consumed_amount")) if ai_budget else None,
                    "prevent_further_usage": ai_budget.get("prevent_further_usage") if ai_budget else None,
                    "budget_alerts_enabled": alerting.get("will_alert") if ai_budget else None,
                    "budget_alert_recipients": ", ".join(
                        alerting.get("alert_recipients") or []
                    ),
                    "usage_gross_quantity": usage_agg.get("gross_quantity") if include_usage else None,
                    "usage_gross_amount": usage_agg.get("gross_amount") if include_usage else None,
                    "usage_net_amount": usage_agg.get("net_amount") if include_usage else None,
                    "raw_details_json": compact_json(details),
                }
            )

            for resource in resources:
                if not isinstance(resource, dict):
                    continue
                resource_rows.append(
                    {
                        "cost_center_id": cost_center_id,
                        "cost_center_name": name,
                        "resource_type": resource.get("type"),
                        "resource_name": resource.get("name"),
                        "resource_email": extract_user_email(resource) or None,
                        "raw_resource_json": compact_json(resource),
                    }
                )
            for budget in matching_budgets:
                budget_alerting = budget.get("budget_alerting")
                if not isinstance(budget_alerting, dict):
                    budget_alerting = {}
                budget_rows.append(
                    {
                        "cost_center_id": cost_center_id,
                        "cost_center_name": name,
                        "budget_id": budget.get("id"),
                        "budget_scope": budget.get("budget_scope"),
                        "budget_entity_name": budget.get("budget_entity_name"),
                        "budget_type": budget.get("budget_type"),
                        "budget_product_sku": first_present(
                            budget,
                            ("budget_product_sku", "budget_product_skus"),
                        ),
                        "budget_amount": safe_float(budget.get("budget_amount")),
                        "consumed_amount": safe_float(budget.get("consumed_amount")),
                        "prevent_further_usage": budget.get("prevent_further_usage"),
                        "alerts_enabled": budget_alerting.get("will_alert"),
                        "alert_recipients": ", ".join(
                            budget_alerting.get("alert_recipients") or []
                        ),
                    }
                )
        return {
            "ok": not errors,
            "Summary": {
                "cost_centers": len(cost_center_rows),
                "resources": len(resource_rows),
                "cost_center_budgets": len(budget_rows),
                "errors": len(errors),
                "state_filter": state,
                "usage_included": include_usage,
                "generated_at": datetime.now(timezone.utc).isoformat(),
            },
            "Cost Centers": cost_center_rows,
            "Resources": resource_rows,
            "Budgets": budget_rows,
            "Usage": usage_rows,
            "Usage Metadata": usage_metadata_rows,
            "Errors": errors,
        }


def parse_date(value: str, name: str) -> datetime:
    try:
        return datetime.strptime(value, "%Y-%m-%d")
    except ValueError as exc:
        raise ValueError(f"{name} must be in YYYY-MM-DD format") from exc


def resolve_ai_credit_report_range(
    *,
    start_date: str | None,
    end_date: str | None,
    year: int | None,
    month: int | None,
    day: int | None,
    today: date | None = None,
) -> tuple[str, str]:
    """Resolve one exact, non-future calendar period for a per-user AI report."""
    period_filters_supplied = any(value is not None for value in (year, month, day))
    explicit_dates_supplied = start_date is not None or end_date is not None
    if period_filters_supplied and explicit_dates_supplied:
        raise ValueError(
            "Use either --start-date/--end-date or --year/--month/--day, not both"
        )
    if end_date is not None and start_date is None:
        raise ValueError("--end-date requires --start-date")

    current = today or datetime.now(timezone.utc).date()
    if explicit_dates_supplied:
        resolved_start = parse_date(start_date or "", "start_date").date()
        if end_date is not None:
            resolved_end = parse_date(end_date, "end_date").date()
        else:
            last_day = calendar.monthrange(
                resolved_start.year,
                resolved_start.month,
            )[1]
            resolved_end = min(
                date(resolved_start.year, resolved_start.month, last_day),
                current,
            )
    else:
        resolved_year = year if year is not None else current.year
        resolved_month = month if month is not None else current.month
        try:
            resolved_start = date(
                resolved_year,
                resolved_month,
                day if day is not None else 1,
            )
        except ValueError as exc:
            raise ValueError(
                "The supplied --year/--month/--day values do not form a valid date"
            ) from exc
        if day is not None:
            resolved_end = resolved_start
        else:
            last_day = calendar.monthrange(resolved_year, resolved_month)[1]
            resolved_end = min(date(resolved_year, resolved_month, last_day), current)

    if resolved_start > current or resolved_end > current:
        raise ValueError("AI-credit report dates must not be in the future")
    if resolved_end < resolved_start:
        raise ValueError("end_date must be on or after start_date")
    if (resolved_end - resolved_start).days > 30:
        raise ValueError("AI usage report date range must not exceed 31 calendar days")
    return resolved_start.isoformat(), resolved_end.isoformat()


def validate_date(value: str, name: str) -> None:
    parse_date(value, name)


def validate_budget_payload(
    *,
    amount: int,
    scope: str,
    budget_type: str,
    sku: str,
    user: str | None,
    prevent: bool,
) -> None:
    if amount < 0:
        raise ValueError("budget amount must be >= 0")
    if scope not in VALID_BUDGET_SCOPES:
        raise ValueError(f"budget scope must be one of {sorted(VALID_BUDGET_SCOPES)}")
    if budget_type not in VALID_BUDGET_TYPES:
        raise ValueError(f"budget type must be one of {sorted(VALID_BUDGET_TYPES)}")
    if scope in USER_BUDGET_SCOPES_REQUIRING_PREVENT and not prevent:
        raise ValueError(f"prevent_further_usage must be true for {scope} budgets")
    if scope in AI_CREDIT_SCOPES and sku not in AI_CREDIT_SKUS:
        raise ValueError(f"{scope} budgets only support {sorted(AI_CREDIT_SKUS)}")
    if scope == "user" and not user:
        raise ValueError("user is required when budget_scope is user")


def safe_float(value: Any) -> float | None:
    if value in (None, ""):
        return None
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def aggregate_usage_items(items: list[dict[str, Any]]) -> dict[str, float]:
    result = {
        "gross_quantity": 0.0,
        "net_quantity": 0.0,
        "discount_quantity": 0.0,
        "gross_amount": 0.0,
        "net_amount": 0.0,
        "discount_amount": 0.0,
    }
    for item in items:
        result["gross_quantity"] += safe_float(
            first_present(item, ("grossQuantity", "gross_quantity", "quantity"), 0)
        ) or 0.0
        result["net_quantity"] += safe_float(
            first_present(item, ("netQuantity", "net_quantity", "quantity"), 0)
        ) or 0.0
        result["discount_quantity"] += safe_float(
            first_present(item, ("discountQuantity", "discount_quantity"), 0)
        ) or 0.0
        result["gross_amount"] += safe_float(first_present(item, ("grossAmount", "gross_amount"), 0)) or 0.0
        result["net_amount"] += safe_float(first_present(item, ("netAmount", "net_amount"), 0)) or 0.0
        result["discount_amount"] += safe_float(first_present(item, ("discountAmount", "discount_amount"), 0)) or 0.0
    return {
        key: round(value, 4 if "quantity" in key else 2)
        for key, value in result.items()
    }


def usage_item_user(item: dict[str, Any]) -> str:
    for key in ("username", "user", "login", "github_login", "actor"):
        value = item.get(key)
        if isinstance(value, str) and value.strip():
            return normalize_login(value)
        if isinstance(value, dict):
            nested = value.get("login") or value.get("name")
            if nested:
                return normalize_login(str(nested))
    return ""


def extract_user_email(item: dict[str, Any]) -> str:
    for key in EMAIL_FIELD_NAMES:
        value = item.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    for key in ("user", "actor", "assignee", "member"):
        value = item.get(key)
        if isinstance(value, dict):
            nested_email = extract_user_email(value)
            if nested_email:
                return nested_email
    return ""


def aggregate_usage_items_by_user(items: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    by_user: dict[str, dict[str, Any]] = {}
    for item in items:
        user = usage_item_user(item)
        if not user:
            continue
        current = by_user.setdefault(
            user,
            {
                "gross_quantity": 0.0,
                "net_quantity": 0.0,
                "discount_quantity": 0.0,
                "gross_amount": 0.0,
                "net_amount": 0.0,
                "discount_amount": 0.0,
                "usage_source": (
                    "ai_credit_report"
                    if any(key in item for key in ("username", "quantity", "gross_amount"))
                    else "ai_credit_usage"
                ),
                "email": "",
            },
        )
        email = extract_user_email(item)
        if email and not current.get("email"):
            current["email"] = email
        current["gross_quantity"] += safe_float(
            first_present(item, ("grossQuantity", "gross_quantity", "quantity"), 0)
        ) or 0.0
        current["net_quantity"] += safe_float(
            first_present(item, ("netQuantity", "net_quantity", "quantity"), 0)
        ) or 0.0
        current["discount_quantity"] += safe_float(
            first_present(item, ("discountQuantity", "discount_quantity"), 0)
        ) or 0.0
        current["gross_amount"] += safe_float(first_present(item, ("grossAmount", "gross_amount"), 0)) or 0.0
        current["net_amount"] += safe_float(first_present(item, ("netAmount", "net_amount"), 0)) or 0.0
        current["discount_amount"] += safe_float(first_present(item, ("discountAmount", "discount_amount"), 0)) or 0.0
    for current in by_user.values():
        current["gross_quantity"] = round(current["gross_quantity"], 4)
        current["net_quantity"] = round(current["net_quantity"], 4)
        current["discount_quantity"] = round(current["discount_quantity"], 4)
        current["gross_amount"] = round(current["gross_amount"], 2)
        current["net_amount"] = round(current["net_amount"], 2)
        current["discount_amount"] = round(current["discount_amount"], 2)
    return by_user


def extract_cost_centers(data: Any) -> list[dict[str, Any]]:
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        return data.get("costCenters") or data.get("cost_centers") or data.get("items") or []
    return []


def cost_center_resources_by_payload_key(resources: Any) -> dict[str, list[str]]:
    result = {
        "users": [],
        "organizations": [],
        "repositories": [],
        "enterprise_teams": [],
    }
    type_to_key = {
        "user": "users",
        "org": "organizations",
        "organization": "organizations",
        "repo": "repositories",
        "repository": "repositories",
        "team": "enterprise_teams",
        "enterprise_team": "enterprise_teams",
    }
    if not isinstance(resources, list):
        return result
    for resource in resources:
        if not isinstance(resource, dict):
            continue
        key = type_to_key.get(str(resource.get("type") or "").strip().casefold())
        name = str(resource.get("name") or "").strip()
        if key and name:
            result[key].append(name)
    return result


def write_output(data: Any, output: str | None, default_name: str, output_dir: Path) -> None:
    if not output:
        print_json(data)
        return
    path = Path(output).expanduser()
    if not path.is_absolute():
        path = output_dir / path
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.suffix.lower() == ".xlsx":
        write_excel(data, path)
    else:
        path.write_text(compact_json(data) + "\n", encoding="utf-8")
    print_json({"output": str(path), "command": default_name, "written": True})


def write_excel(data: Any, path: Path) -> None:
    try:
        import pandas as pd
        from openpyxl import load_workbook
        from openpyxl.styles import Font, PatternFill
    except ImportError as exc:
        raise RuntimeError("pandas and openpyxl are required for .xlsx output") from exc

    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_file = tempfile.NamedTemporaryFile(
        prefix=f".{path.stem}-",
        suffix=".xlsx",
        dir=path.parent,
        delete=False,
    )
    temporary_file.close()
    temporary_path = Path(temporary_file.name)
    try:
        with pd.ExcelWriter(temporary_path, engine="openpyxl") as writer:
            if isinstance(data, dict):
                wrote = False
                for key, value in data.items():
                    if isinstance(value, list):
                        rows = [
                            {column: excel_safe_value(cell) for column, cell in row.items()}
                            if isinstance(row, dict)
                            else {"value": excel_safe_value(row)}
                            for row in value
                        ]
                        pd.DataFrame(rows).to_excel(
                            writer,
                            sheet_name=safe_sheet_name(str(key)),
                            index=False,
                        )
                        wrote = True
                    elif isinstance(value, dict):
                        safe_row = {
                            column: excel_safe_value(cell) for column, cell in value.items()
                        }
                        pd.DataFrame([safe_row]).to_excel(
                            writer,
                            sheet_name=safe_sheet_name(str(key)),
                            index=False,
                        )
                        wrote = True
                if not wrote:
                    pd.DataFrame(
                        [{column: excel_safe_value(cell) for column, cell in data.items()}]
                    ).to_excel(writer, sheet_name="Data", index=False)
            elif isinstance(data, list):
                rows = [
                    {column: excel_safe_value(cell) for column, cell in row.items()}
                    if isinstance(row, dict)
                    else {"value": excel_safe_value(row)}
                    for row in data
                ]
                pd.DataFrame(rows).to_excel(writer, sheet_name="Data", index=False)
            else:
                pd.DataFrame([{"value": excel_safe_value(data)}]).to_excel(
                    writer,
                    sheet_name="Data",
                    index=False,
                )

        workbook = load_workbook(temporary_path)
        if not workbook.sheetnames:
            raise RuntimeError("Generated workbook has no worksheets")
        for worksheet in workbook.worksheets:
            if worksheet.max_row >= 1:
                worksheet.freeze_panes = "A2"
                for cell in worksheet[1]:
                    cell.font = Font(bold=True, color="FFFFFF")
                    cell.fill = PatternFill("solid", fgColor="1F4E78")
                if worksheet.max_column > 0:
                    worksheet.auto_filter.ref = worksheet.dimensions
                for column_cells in worksheet.iter_cols(
                    min_row=1,
                    max_row=min(worksheet.max_row, 5000),
                ):
                    width = max(
                        (len(str(cell.value)) for cell in column_cells if cell.value is not None),
                        default=10,
                    )
                    worksheet.column_dimensions[column_cells[0].column_letter].width = min(
                        max(width + 2, 10),
                        60,
                    )
        workbook.save(temporary_path)
        workbook.close()

        validation_workbook = load_workbook(temporary_path, read_only=True, data_only=False)
        if not validation_workbook.sheetnames:
            raise RuntimeError("Generated workbook failed validation")
        validation_workbook.close()
        temporary_path.replace(path)
    except Exception:
        temporary_path.unlink(missing_ok=True)
        raise


def excel_safe_value(value: Any) -> Any:
    if isinstance(value, str):
        # Treat every API/user-provided string as data. Excel interprets these
        # leading characters as formulas, including in otherwise plain cells.
        if value.startswith(("=", "+", "-", "@", "\t", "\r", "\n")):
            return f"'{value}"
        return value
    if value is None or isinstance(value, (int, float, bool, datetime, date)):
        return value
    if isinstance(value, (dict, list, tuple, set)):
        serializable = list(value) if isinstance(value, set) else value
        return json.dumps(serializable, ensure_ascii=False, sort_keys=True, default=str)
    return str(value)


def safe_sheet_name(value: str) -> str:
    sanitized = re.sub(r"[\[\]:*?/\\]", "_", value).strip()
    return (sanitized or "Data")[:31]


def automatic_excel_output(command: str) -> str | None:
    prefixes = {
        "all-users-consumption": "all_users_consumption",
        "export-all-users-consumption": "all_users_consumption",
        "cost-centers-report": "cost_centers_details",
        "export-cost-centers": "cost_centers_details",
    }
    prefix = prefixes.get(command)
    return f"{prefix}_{filename_timestamp()}.xlsx" if prefix else None


