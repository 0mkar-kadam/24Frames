def client_from_args(args: argparse.Namespace) -> GitHubBillingClient:
    return GitHubBillingClient(GitHubConfig.from_env(dry_run=args.dry_run))


def normalize_global_options(argv: list[str]) -> list[str]:
    """Allow --dry-run and --output before or after the subcommand."""
    global_options: list[str] = []
    remaining: list[str] = []
    index = 0
    while index < len(argv):
        value = argv[index]
        if value == "--dry-run":
            global_options.append(value)
            index += 1
            continue
        if value in {"--output", "-o"}:
            if index + 1 >= len(argv):
                raise ValueError(f"{value} requires a path")
            global_options.extend([value, argv[index + 1]])
            index += 2
            continue
        if value.startswith("--output="):
            global_options.append(value)
            index += 1
            continue
        remaining.append(value)
        index += 1
    return global_options + remaining


def require_confirmation(*, confirmed: bool, dry_run: bool, operation: str) -> None:
    if not confirmed and not dry_run:
        raise ValueError(f"{operation} requires --yes")


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    if not argv:
        parser.print_help(sys.stderr)
        print(
            "\nExamples:\n"
            "  ./.venv/bin/python github_billing_cost_center_apis.py apis\n"
            "  ./.venv/bin/python github_billing_cost_center_apis.py --dry-run list-budgets --scope user\n"
            "  ./.venv/bin/python github_billing_cost_center_apis.py list-cost-centers --state active\n",
            file=sys.stderr,
        )
        return 2
    try:
        args = parser.parse_args(normalize_global_options(argv))
        if args.command == "apis":
            print_json(api_registry())
            return 0

        client = client_from_args(args)
        data = dispatch(client, args)
        output = args.output or (
            None if args.dry_run else automatic_excel_output(args.command)
        )
        write_output(data, output, args.command, client.config.output_dir)
        return 1 if isinstance(data, dict) and data.get("ok") is False else 0
    except (
        GitHubApiError,
        OSError,
        ValueError,
        RuntimeError,
        requests.RequestException,
    ) as exc:
        print_json({"error": type(exc).__name__, "message": str(exc)})
        return 1


def dispatch(client: GitHubBillingClient, args: argparse.Namespace) -> Any:
    command = args.command
    if command == "list-budgets":
        return client.list_budgets(
            owner_type=args.owner_type,
            org=args.org,
            scope=args.scope,
            user=args.user,
            all_pages=args.all_pages,
        )
    if command == "get-budget":
        return client.get_budget(args.budget_id, owner_type=args.owner_type, org=args.org)
    if command == "create-budget":
        if args.scope == "cost_center":
            raise ValueError(
                "Use assign-cost-center-budget so the bundled AI-credit, stop-usage, "
                "alert, and login-recipient policy is enforced"
            )
        if args.scope == "multi_user_cost_center":
            raise ValueError(
                "Use assign-cost-center-per-user-budget so the per-user AI-credit, "
                "stop-usage, and no-alert policy is enforced"
            )
        return client.create_budget(
            amount=args.amount,
            scope=args.scope,
            entity_name=args.entity_name,
            budget_type=args.budget_type,
            sku=args.sku,
            user=args.user,
            prevent=True,
            will_alert=args.will_alert,
            alert_recipients=comma_list(args.alert_recipients),
            owner_type=args.owner_type,
            org=args.org,
        )
    if command == "create-user-budget":
        return client.create_user_budget(user=args.user, amount=args.amount, owner_type=args.owner_type, org=args.org)
    if command in {"create-user-budgets", "bulk-create-user-budgets"}:
        return client.bulk_create_user_budgets(
            users=collect_logins(
                user=args.user,
                users=args.users,
                users_file=args.users_file,
            ),
            amount=args.amount,
            update_existing=args.update_existing,
        )
    if command == "update-budget":
        patch = json.loads(args.patch_json)
        if patch.get("budget_scope") == "cost_center":
            raise ValueError(
                "Use assign-cost-center-budget for cost-center budget changes"
            )
        if patch.get("budget_scope") == "multi_user_cost_center":
            raise ValueError(
                "Use assign-cost-center-per-user-budget for cost-center per-user budget changes"
            )
        if not client.config.dry_run:
            current_budget = unwrap_budget(
                client.get_budget(
                    args.budget_id,
                    owner_type=args.owner_type,
                    org=args.org,
                )
            )
            if current_budget.get("budget_scope") in {
                "cost_center",
                "multi_user_cost_center",
            }:
                if current_budget.get("budget_scope") == "multi_user_cost_center":
                    raise ValueError(
                        "Use assign-cost-center-per-user-budget for cost-center per-user budget changes"
                    )
                raise ValueError(
                    "Use assign-cost-center-budget for cost-center budget changes"
                )
        return client.update_budget(
            args.budget_id,
            patch,
            owner_type=args.owner_type,
            org=args.org,
        )
    if command == "increase-user-budget":
        return client.increase_user_budget(
            user=args.user,
            budget_id=args.budget_id,
            new_amount=args.new_amount,
            increase_by=args.increase_by,
            owner_type=args.owner_type,
            org=args.org,
        )
    if command == "delete-budget":
        require_confirmation(
            confirmed=args.yes,
            dry_run=client.config.dry_run,
            operation="Deleting a budget",
        )
        if not client.config.dry_run:
            current_budget = unwrap_budget(
                client.get_budget(
                    args.budget_id,
                    owner_type=args.owner_type,
                    org=args.org,
                )
            )
            if current_budget.get("budget_scope") in {
                "cost_center",
                "multi_user_cost_center",
            }:
                raise ValueError(
                    "Use remove-cost-center-budget for cost-center budget deletion"
                )
        return client.delete_budget(args.budget_id, owner_type=args.owner_type, org=args.org)
    if command == "multi-user-budget-states":
        return client.get_multi_user_budget_states(
            args.budget_id,
            user=args.user,
            threshold_lower_bound=args.threshold_lower_bound,
            threshold_upper_bound=args.threshold_upper_bound,
            sort_order=args.sort_order,
        )
    if command == "enterprise-ai-usage":
        return client.get_enterprise_ai_credit_usage(
            year=args.year,
            month=args.month,
            day=args.day,
            organization=args.organization,
            user=args.user,
            model=args.model,
            product=args.product,
            cost_center_id=args.cost_center_id,
        )
    if command == "list-usage-reports":
        return client.list_usage_reports()
    if command == "create-usage-report":
        return client.create_usage_report(
            report_type=args.report_type,
            start_date=args.start_date,
            end_date=args.end_date,
            send_email=args.send_email,
        )
    if command == "get-usage-report":
        return client.get_usage_report(args.report_id)
    if command == "list-copilot-seats":
        return client.list_enterprise_copilot_seats(all_pages=args.all_pages)
    if command in {"all-users-consumption", "export-all-users-consumption"}:
        return client.build_all_users_budget_consumption(
            usage_source=args.usage_source,
            start_date=args.start_date,
            end_date=args.end_date,
            year=args.year,
            month=args.month,
            day=args.day,
            report_timeout_seconds=args.report_timeout,
            report_poll_seconds=args.poll_seconds,
        )
    if command == "list-cost-centers":
        return client.list_cost_centers(state=args.state)
    if command == "get-cost-center":
        return client.get_cost_center(args.cost_center_id, page=args.page, per_page=args.per_page)
    if command == "create-cost-center":
        return client.create_cost_center(name=args.name)
    if command == "create-enterprise-organization":
        return client.create_enterprise_organization(
            login=args.login,
            billing_email=args.billing_email,
            admin_logins=collect_admin_logins(
                admin_login=args.admin_login,
                admin_logins=args.admin_logins,
            ),
            enterprise_id=args.enterprise_id,
            enterprise_slug=args.enterprise_slug,
        )
    if command == "update-cost-center":
        return client.update_cost_center(
            cost_center_id=args.cost_center_id,
            name=args.name,
            ai_credit_pool_enabled=(
                None if args.ai_credit_pool_enabled is None else args.ai_credit_pool_enabled == "true"
            ),
        )
    if command == "delete-cost-center":
        require_confirmation(
            confirmed=args.yes,
            dry_run=client.config.dry_run,
            operation="Archiving a cost center",
        )
        cost_center = client.resolve_cost_center(
            cost_center_id=args.cost_center_id,
            cost_center_name=args.cost_center_name,
        )
        return client.delete_cost_center(cost_center_id=str(cost_center.get("id") or ""))
    if command == "add-cost-center-resources":
        return client.add_cost_center_resources(
            cost_center_id=args.cost_center_id,
            users=comma_list(args.users),
            organizations=comma_list(args.organizations),
            repositories=comma_list(args.repositories),
            enterprise_teams=comma_list(args.enterprise_teams),
            allow_reassignment=args.allow_reassignment,
        )
    if command == "map-users-to-cost-center":
        return client.add_cost_center_resources(
            cost_center_id=args.cost_center_id,
            users=comma_list(args.users),
            allow_reassignment=args.allow_reassignment,
        )
    if command == "remove-cost-center-resources":
        require_confirmation(
            confirmed=args.yes,
            dry_run=client.config.dry_run,
            operation="Removing cost-center resources",
        )
        return client.remove_cost_center_resources(
            cost_center_id=args.cost_center_id,
            users=comma_list(args.users),
            organizations=comma_list(args.organizations),
            repositories=comma_list(args.repositories),
            enterprise_teams=comma_list(args.enterprise_teams),
        )
    if command in {"add-user-to-cost-center", "add-users-to-cost-center"}:
        cost_center = client.resolve_cost_center(
            cost_center_id=args.cost_center_id,
            cost_center_name=args.cost_center_name,
        )
        users = collect_logins(
            user=getattr(args, "user", None),
            users=getattr(args, "users", None),
            users_file=getattr(args, "users_file", None),
        )
        return client.add_cost_center_resources(
            cost_center_id=str(cost_center.get("id") or ""),
            users=users,
            allow_reassignment=args.allow_reassignment,
        )
    if command in {"remove-user-from-cost-center", "remove-users-from-cost-center"}:
        require_confirmation(
            confirmed=args.yes,
            dry_run=client.config.dry_run,
            operation="Removing users from a cost center",
        )
        cost_center = client.resolve_cost_center(
            cost_center_id=args.cost_center_id,
            cost_center_name=args.cost_center_name,
        )
        users = collect_logins(
            user=getattr(args, "user", None),
            users=getattr(args, "users", None),
            users_file=getattr(args, "users_file", None),
        )
        return client.remove_cost_center_resources(
            cost_center_id=str(cost_center.get("id") or ""),
            users=users,
        )
    if command == "assign-cost-center-budget":
        return client.assign_cost_center_budget(
            amount=args.amount,
            alert_recipient=args.alert_recipient,
            cost_center_id=args.cost_center_id,
            cost_center_name=args.cost_center_name,
        )
    if command == "assign-cost-center-per-user-budget":
        return client.assign_cost_center_per_user_budget(
            amount=args.amount,
            cost_center_id=args.cost_center_id,
            cost_center_name=args.cost_center_name,
        )
    if command == "remove-cost-center-budget":
        require_confirmation(
            confirmed=args.yes,
            dry_run=client.config.dry_run,
            operation="Deleting a cost-center budget",
        )
        return client.remove_cost_center_budget(
            budget_id=args.budget_id,
            cost_center_id=args.cost_center_id,
            cost_center_name=args.cost_center_name,
        )
    if command == "monthly-budget-reset":
        return client.monthly_budget_reset(
            baseline_file=args.baseline_file,
            prior_month_audit_file=args.prior_month_audit_file,
            reset_month=args.reset_month,
            report_dir=args.report_dir,
            confirmed=args.yes,
        )
    if command in {"cost-centers-report", "export-cost-centers"}:
        return client.build_cost_centers_report(
            state=args.state,
            include_usage=args.include_usage,
        )
    raise ValueError(f"unknown command: {command}")


