    def find_cost_center_resource_conflicts(
        self,
        *,
        target_cost_center_id: str,
        payload: dict[str, list[str]],
    ) -> list[dict[str, Any]]:
        """Find requested resources currently assigned to another active center."""
        target_cost_center_id = validate_resource_id(
            target_cost_center_id,
            "target_cost_center_id",
        )
        requested = {
            key: {value.casefold(): value for value in values}
            for key, values in payload.items()
            if values
        }
        conflicts: list[dict[str, Any]] = []
        for center in extract_cost_centers(self.list_cost_centers(state="active")):
            center_id = str(center.get("id") or "")
            if not center_id or center_id == target_cost_center_id:
                continue
            center_id = validate_resource_id(center_id, "cost_center_id")
            details = self.get_cost_center(center_id)
            actual = cost_center_resources_by_payload_key(details.get("resources", []))
            for resource_type, requested_by_key in requested.items():
                for actual_value in actual.get(resource_type, []):
                    key = actual_value.casefold()
                    if key in requested_by_key:
                        conflicts.append(
                            {
                                "resource_type": resource_type,
                                "resource": requested_by_key[key],
                                "current_cost_center_id": center_id,
                                "current_cost_center_name": center.get("name")
                                or details.get("name"),
                            }
                        )
        return conflicts

    def add_cost_center_resources(
        self,
        *,
        cost_center_id: str,
        users: list[str] | None = None,
        organizations: list[str] | None = None,
        repositories: list[str] | None = None,
        enterprise_teams: list[str] | None = None,
        allow_reassignment: bool = False,
    ) -> dict[str, Any]:
        cost_center_id = validate_resource_id(cost_center_id, "cost_center_id")
        payload = {
            "users": unique_preserving_order(
                [validate_login(value) for value in (users or [])],
                case_insensitive=True,
            ),
            "organizations": unique_preserving_order(organizations or [], case_insensitive=True),
            "repositories": unique_preserving_order(repositories or [], case_insensitive=True),
            "enterprise_teams": unique_preserving_order(enterprise_teams or [], case_insensitive=True),
        }
        require_any_resource(payload)
        reassignment_conflicts: list[dict[str, Any]] = []
        if not self.config.dry_run:
            reassignment_conflicts = self.find_cost_center_resource_conflicts(
                target_cost_center_id=cost_center_id,
                payload=payload,
            )
            if reassignment_conflicts and not allow_reassignment:
                return {
                    "ok": False,
                    "operation": "blocked_reassignment",
                    "cost_center_id": cost_center_id,
                    "requested_resources": sum(
                        len(values) for values in payload.values()
                    ),
                    "reassignment_conflicts": reassignment_conflicts,
                    "message": (
                        "GitHub would move these resources out of another cost center. "
                        "Review the conflicts and rerun with --allow-reassignment."
                    ),
                    "verified": False,
                }
        endpoint = f"/enterprises/{self._enterprise_slug()}/settings/billing/cost-centers/{cost_center_id}/resource"
        batches = chunk_resource_payloads(payload)
        results: list[dict[str, Any]] = []
        for index, batch in enumerate(batches, start=1):
            try:
                response = self._request(
                    "POST",
                    endpoint,
                    json_body=batch,
                    source=DOCS_COST_CENTERS,
                )
                results.append(
                    {"batch": index, "status": "planned" if self.config.dry_run else "applied", "payload": batch, "response": response}
                )
            except (GitHubApiError, requests.RequestException) as exc:
                results.append(
                    {
                        "batch": index,
                        "status": "failed",
                        "payload": batch,
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        failed_batches = sum(1 for item in results if item["status"] == "failed")
        missing: dict[str, list[str]] = {}
        readback_error: dict[str, str] | None = None
        if not self.config.dry_run:
            try:
                details = self.get_cost_center(cost_center_id)
                actual = cost_center_resources_by_payload_key(details.get("resources", []))
                for key, expected in payload.items():
                    actual_keys = {
                        item.casefold() for item in actual.get(key, [])
                    }
                    absent = [
                        value for value in expected if value.casefold() not in actual_keys
                    ]
                    if absent:
                        missing[key] = absent
            except (
                GitHubApiError,
                requests.RequestException,
                ValueError,
                RuntimeError,
            ) as exc:
                readback_error = {
                    "error_type": type(exc).__name__,
                    "error": str(exc),
                }
        verified = (
            not self.config.dry_run
            and not missing
            and readback_error is None
        )
        return {
            "ok": self.config.dry_run or verified,
            "dry_run": self.config.dry_run,
            "operation": "add_resources",
            "cost_center_id": cost_center_id,
            "requested_resources": sum(len(values) for values in payload.values()),
            "batches": results,
            "failed_batches": failed_batches,
            "reassignment_conflicts": reassignment_conflicts,
            "reassignment_allowed": allow_reassignment,
            "missing_after_readback": missing,
            "readback_error": readback_error,
            "verified": verified,
            "verification_status": (
                "not_performed_dry_run"
                if self.config.dry_run
                else "verified"
                if verified
                else "failed"
            ),
        }

    def remove_cost_center_resources(
        self,
        *,
        cost_center_id: str,
        users: list[str] | None = None,
        organizations: list[str] | None = None,
        repositories: list[str] | None = None,
        enterprise_teams: list[str] | None = None,
    ) -> dict[str, Any]:
        cost_center_id = validate_resource_id(cost_center_id, "cost_center_id")
        payload = {
            "users": unique_preserving_order(
                [validate_login(value) for value in (users or [])],
                case_insensitive=True,
            ),
            "organizations": unique_preserving_order(organizations or [], case_insensitive=True),
            "repositories": unique_preserving_order(repositories or [], case_insensitive=True),
            "enterprise_teams": unique_preserving_order(enterprise_teams or [], case_insensitive=True),
        }
        require_any_resource(payload)
        endpoint = f"/enterprises/{self._enterprise_slug()}/settings/billing/cost-centers/{cost_center_id}/resource"
        batches = chunk_resource_payloads(payload)
        results: list[dict[str, Any]] = []
        for index, batch in enumerate(batches, start=1):
            try:
                response = self._request(
                    "DELETE",
                    endpoint,
                    json_body=batch,
                    source=DOCS_COST_CENTERS,
                )
                results.append(
                    {"batch": index, "status": "planned" if self.config.dry_run else "applied", "payload": batch, "response": response}
                )
            except (GitHubApiError, requests.RequestException) as exc:
                results.append(
                    {
                        "batch": index,
                        "status": "failed",
                        "payload": batch,
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        failed_batches = sum(1 for item in results if item["status"] == "failed")
        still_present: dict[str, list[str]] = {}
        readback_error: dict[str, str] | None = None
        if not self.config.dry_run:
            try:
                details = self.get_cost_center(cost_center_id)
                actual = cost_center_resources_by_payload_key(details.get("resources", []))
                for key, expected in payload.items():
                    actual_keys = {
                        item.casefold() for item in actual.get(key, [])
                    }
                    present = [
                        value for value in expected if value.casefold() in actual_keys
                    ]
                    if present:
                        still_present[key] = present
            except (
                GitHubApiError,
                requests.RequestException,
                ValueError,
                RuntimeError,
            ) as exc:
                readback_error = {
                    "error_type": type(exc).__name__,
                    "error": str(exc),
                }
        verified = (
            not self.config.dry_run
            and not still_present
            and readback_error is None
        )
        return {
            "ok": self.config.dry_run or verified,
            "dry_run": self.config.dry_run,
            "operation": "remove_resources",
            "cost_center_id": cost_center_id,
            "requested_resources": sum(len(values) for values in payload.values()),
            "batches": results,
            "failed_batches": failed_batches,
            "still_present_after_readback": still_present,
            "readback_error": readback_error,
            "verified": verified,
            "verification_status": (
                "not_performed_dry_run"
                if self.config.dry_run
                else "verified"
                if verified
                else "failed"
            ),
        }

