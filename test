    def create_usage_report(
        self,
        *,
        report_type: str,
        start_date: str,
        end_date: str | None = None,
        send_email: bool = False,
    ) -> dict[str, Any]:
        if report_type not in VALID_REPORT_TYPES:
            raise ValueError(f"report_type must be one of {sorted(VALID_REPORT_TYPES)}")
        parsed_start = parse_date(start_date, "start_date")
        if end_date:
            parsed_end = parse_date(end_date, "end_date")
            if parsed_end < parsed_start:
                raise ValueError("end_date must be on or after start_date")
            if report_type in {"ai_credit", "premium_request"} and (parsed_end - parsed_start).days > 30:
                raise ValueError("AI usage report date range must not exceed 31 calendar days")
        endpoint = f"/enterprises/{self._enterprise_slug()}/settings/billing/reports"
        payload = {
            "report_type": report_type,
            "start_date": start_date,
            "send_email": send_email,
        }
        if end_date:
            payload["end_date"] = end_date
        return self._request(
            "POST",
            endpoint,
            json_body=payload,
            expected_status=(200, 201, 202),
            source=DOCS_USAGE_REPORTS,
        )

