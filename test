class GitHubApiError(RuntimeError):
    """Raised when GitHub returns an unsuccessful REST API response."""

    def __init__(
        self,
        method: str,
        url: str,
        status_code: int,
        message: str,
        body: Any | None = None,
    ) -> None:
        super().__init__(f"{method} {url} failed with HTTP {status_code}: {message}")
        self.method = method
        self.url = url
        self.status_code = status_code
        self.message = message
        self.body = body


class MonthlyBudgetResetError(ValueError):
    """Raised after a guarded monthly reset writes its failure audit report."""

    def __init__(self, message: str, audit_report: Path) -> None:
        super().__init__(f"{message}; audit report: {audit_report}")
        self.audit_report = audit_report


@dataclass(frozen=True)
class GitHubConfig:
    token: str
    enterprise: str
    org: str
    base_url: str
    api_version: str
    connect_timeout: int
    read_timeout: int
    verify: bool | str
    output_dir: Path
    alert_recipient_login: str = ""
    dry_run: bool = False

    @property
    def timeout(self) -> tuple[int, int]:
        return (self.connect_timeout, self.read_timeout)

    @classmethod
    def from_env(cls, *, dry_run: bool = False) -> "GitHubConfig":
        repo_root = Path(__file__).resolve().parent
        load_dotenv(repo_root / ".env")

        token = os.environ.get("GITHUB_TOKEN", "").strip()
        if not token and not dry_run:
            raise ValueError("GITHUB_TOKEN is required in .env or the process environment")

        verify: bool | str = True
        insecure = os.environ.get("GITHUB_INSECURE_SKIP_TLS_VERIFY", "").strip().lower()
        if insecure in {"1", "true", "yes"}:
            verify = False
        else:
            ca_bundle = (
                os.environ.get("GITHUB_CA_BUNDLE", "").strip()
                or os.environ.get("REQUESTS_CA_BUNDLE", "").strip()
            )
            if ca_bundle:
                ca_path = Path(ca_bundle).expanduser()
                if not ca_path.exists():
                    raise ValueError(f"Configured CA bundle does not exist: {ca_path}")
                verify = str(ca_path)

        output_dir = Path(os.environ.get("GITHUB_OUTPUT_DIR", "Export-Data")).expanduser()
        if not output_dir.is_absolute():
            output_dir = repo_root / output_dir

        enterprise = validate_slug(
            os.environ.get("GITHUB_ENTERPRISE", DEFAULT_ENTERPRISE),
            "GITHUB_ENTERPRISE",
        )
        org = validate_slug(os.environ.get("GITHUB_ORG", DEFAULT_ORG), "GITHUB_ORG")
        base_url = os.environ.get("GITHUB_BASE_URL", DEFAULT_BASE_URL).strip().rstrip("/")
        if not base_url.startswith("https://"):
            raise ValueError("GITHUB_BASE_URL must use HTTPS")
        api_version = os.environ.get("GITHUB_API_VERSION", DEFAULT_API_VERSION).strip()
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", api_version):
            raise ValueError("GITHUB_API_VERSION must use YYYY-MM-DD format")
        try:
            connect_timeout = int(
                os.environ.get("HTTP_CONNECT_TIMEOUT", DEFAULT_TIMEOUT[0])
            )
            read_timeout = int(os.environ.get("HTTP_READ_TIMEOUT", DEFAULT_TIMEOUT[1]))
        except ValueError as exc:
            raise ValueError("HTTP timeouts must be whole seconds") from exc
        if connect_timeout <= 0 or read_timeout <= 0:
            raise ValueError("HTTP timeouts must be positive")

        return cls(
            token=token or "dry-run-token",
            enterprise=enterprise,
            org=org,
            base_url=base_url,
            api_version=api_version,
            connect_timeout=connect_timeout,
            read_timeout=read_timeout,
            verify=verify,
            output_dir=output_dir,
            alert_recipient_login=os.environ.get("GITHUB_ALERT_RECIPIENT", "").strip(),
            dry_run=dry_run,
        )


def load_dotenv(path: Path) -> None:
    """Load KEY=VALUE lines from .env without overriding exported variables."""
    if not path.exists():
        return
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if key and key not in os.environ:
            os.environ[key] = value


def compact_json(data: Any) -> str:
    return json.dumps(data, indent=2, sort_keys=False, ensure_ascii=False)


def print_json(data: Any) -> None:
    print(compact_json(data))


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed < 0:
        raise argparse.ArgumentTypeError("value must be >= 0")
    return parsed


def positive_nonzero_int(value: str) -> int:
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("value must be a positive whole number")
    return parsed


def comma_list(value: str | None) -> list[str]:
    if not value:
        return []
    return [part.strip() for part in value.split(",") if part.strip()]


def unique_preserving_order(values: list[str], *, case_insensitive: bool = False) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for raw_value in values:
        value = raw_value.strip()
        if not value:
            continue
        key = value.casefold() if case_insensitive else value
        if key in seen:
            continue
        seen.add(key)
        result.append(value)
    return result


def validate_login(login: str) -> str:
    clean_login = login.strip()
    if not clean_login:
        raise ValueError("GitHub login must not be blank")
    if not LOGIN_PATTERN.fullmatch(clean_login):
        raise ValueError(
            f"Invalid GitHub login {login!r}; use only letters, digits, hyphens, and underscores"
        )
    return clean_login


def validate_resource_id(value: str, label: str) -> str:
    clean_value = value.strip()
    if not RESOURCE_ID_PATTERN.fullmatch(clean_value):
        raise ValueError(f"{label} contains invalid characters")
    return clean_value


def validate_graphql_id(value: str, label: str) -> str:
    clean_value = value.strip()
    if not clean_value or len(clean_value) > 512 or any(character.isspace() for character in clean_value):
        raise ValueError(f"{label} must be a non-blank GraphQL node ID")
    return clean_value


def validate_slug(value: str, label: str) -> str:
    clean_value = value.strip()
    if not SLUG_PATTERN.fullmatch(clean_value):
        raise ValueError(f"{label} contains invalid characters")
    return clean_value


def validate_billing_email(value: str) -> str:
    clean_value = value.strip()
    if len(clean_value) > 254 or not EMAIL_PATTERN.fullmatch(clean_value):
        raise ValueError("billing_email must be a valid email address")
    if any(ord(character) < 32 for character in clean_value):
        raise ValueError("billing_email must not contain control characters")
    return clean_value


def load_logins_file(path_value: str | None) -> list[str]:
    if not path_value:
        return []
    path = Path(path_value).expanduser()
    if not path.is_file():
        raise ValueError(f"Users file does not exist or is not a regular file: {path}")
    if path.stat().st_size > 5 * 1024 * 1024:
        raise ValueError(f"Users file is larger than the 5 MiB safety limit: {path}")

    text = path.read_text(encoding="utf-8-sig")
    if path.suffix.casefold() == ".json":
        try:
            parsed = json.loads(text)
        except json.JSONDecodeError as exc:
            raise ValueError(f"Invalid JSON in users file {path}: {exc}") from exc
        if isinstance(parsed, dict):
            parsed = parsed.get("users")
        if not isinstance(parsed, list) or not all(isinstance(item, str) for item in parsed):
            raise ValueError("JSON users file must be an array of logins or an object with a users array")
        return [item for item in parsed]

    if path.suffix.casefold() == ".csv":
        rows = [
            row
            for row in csv.reader(io.StringIO(text))
            if row and any(cell.strip() for cell in row)
        ]
        if not rows:
            return []
        supported_headers = {"user", "users", "login", "username", "github_login"}
        normalized_header = [cell.strip().casefold() for cell in rows[0]]
        login_column = next(
            (index for index, header in enumerate(normalized_header) if header in supported_headers),
            None,
        )
        if login_column is not None:
            return [
                row[login_column]
                for row in rows[1:]
                if login_column < len(row) and row[login_column].strip()
            ]
        if any(len(row) != 1 for row in rows):
            raise ValueError(
                "CSV users file must have one column or a user/login/username/github_login header"
            )
        return [row[0] for row in rows]

    values: list[str] = []
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        values.extend(comma_list(line))
    return values


def collect_logins(
    *,
    user: str | None = None,
    users: str | None = None,
    users_file: str | None = None,
) -> list[str]:
    values = ([user] if user else []) + comma_list(users) + load_logins_file(users_file)
    unique_values = unique_preserving_order(values, case_insensitive=True)
    if not unique_values:
        raise ValueError("Provide at least one GitHub login with --user, --users, or --users-file")
    return [validate_login(value) for value in unique_values]


def collect_admin_logins(*, admin_login: list[str] | None = None, admin_logins: str | None = None) -> list[str]:
    values = list(admin_login or []) + comma_list(admin_logins)
    unique_values = unique_preserving_order(values, case_insensitive=True)
    if not unique_values:
        raise ValueError("Provide at least one organization admin with --admin-login or --admin-logins")
    return [validate_login(value) for value in unique_values]


