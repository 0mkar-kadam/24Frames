    def get_cost_center(
        self,
        cost_center_id: str,
        *,
        page: int | None = None,
        per_page: int = 100,
    ) -> dict[str, Any]:
        cost_center_id = validate_resource_id(cost_center_id, "cost_center_id")
        endpoint = f"/enterprises/{self._enterprise_slug()}/settings/billing/cost-centers/{cost_center_id}"
        if per_page <= 0 or per_page > 100:
            raise ValueError("per_page must be between 1 and 100")
        first_page = page or 1
        data = self._request(
            "GET",
            endpoint,
            params={"page": first_page, "per_page": per_page},
            source=DOCS_COST_CENTERS,
        )
        if page is not None or not isinstance(data, dict):
            return data

        merged = dict(data)
        resources = list(data.get("resources", [])) if isinstance(data.get("resources"), list) else []
        seen = {
            (str(resource.get("type") or "").casefold(), str(resource.get("name") or "").casefold())
            for resource in resources
            if isinstance(resource, dict)
        }
        next_page = 2
        pages_fetched = 1
        while len(resources) >= (next_page - 1) * per_page:
            next_data = self._request(
                "GET",
                endpoint,
                params={"page": next_page, "per_page": per_page},
                source=DOCS_COST_CENTERS,
            )
            pages_fetched += 1
            next_resources = (
                next_data.get("resources", [])
                if isinstance(next_data, dict) and isinstance(next_data.get("resources"), list)
                else []
            )
            if not next_resources:
                break
            added = 0
            for resource in next_resources:
                if not isinstance(resource, dict):
                    continue
                key = (
                    str(resource.get("type") or "").casefold(),
                    str(resource.get("name") or "").casefold(),
                )
                if key in seen:
                    continue
                seen.add(key)
                resources.append(resource)
                added += 1
            if added == 0 or len(next_resources) < per_page:
                break
            next_page += 1
            if next_page > 251:
                raise RuntimeError(
                    f"Cost center {cost_center_id} exceeded the documented 25,000-resource limit"
                )
        merged["resources"] = resources
        merged["resource_pages_fetched"] = pages_fetched
        return merged

    def create_cost_center(self, *, name: str) -> dict[str, Any]:
        clean_name = validate_cost_center_name(name)
        if not self.config.dry_run:
            exact_matches = [
                item
                for item in extract_cost_centers(self.list_cost_centers(state="active"))
                if str(item.get("name") or "").strip().casefold() == clean_name.casefold()
            ]
            if exact_matches:
                existing = dict(exact_matches[0])
                existing["operation"] = "already_exists"
                existing["verified"] = True
                existing["ok"] = True
                return existing
        endpoint = f"/enterprises/{self._enterprise_slug()}/settings/billing/cost-centers"
        try:
            response = self._request(
                "POST",
                endpoint,
                json_body={"name": clean_name},
                expected_status=(200, 201),
                source=DOCS_COST_CENTERS,
            )
        except GitHubApiError as exc:
            if exc.status_code != 409:
                raise
            exact_matches = [
                item
                for item in extract_cost_centers(self.list_cost_centers(state="active"))
                if str(item.get("name") or "").strip().casefold() == clean_name.casefold()
            ]
            if not exact_matches:
                raise
            existing = dict(exact_matches[0])
            existing["operation"] = "already_exists"
            existing["verified"] = True
            existing["ok"] = True
            return existing

        if self.config.dry_run:
            return {
                "ok": True,
                "dry_run": True,
                "operation": "planned",
                "name": clean_name,
                "verified": False,
                "verification_status": "not_performed_dry_run",
                "response": response,
            }
        created_id = str(response.get("id") or "") if isinstance(response, dict) else ""
        verified = self.get_cost_center(created_id) if created_id else {}
        verified_name = str(verified.get("name") or "") if isinstance(verified, dict) else ""
        return {
            "ok": bool(created_id and verified_name == clean_name),
            "operation": "created",
            "id": created_id or None,
            "name": clean_name,
            "verified": bool(created_id and verified_name == clean_name),
            "cost_center": verified,
        }

