def first_present(mapping: dict[str, Any], names: tuple[str, ...], default: Any = None) -> Any:
    for name in names:
        value = mapping.get(name)
        if value not in (None, ""):
            return value
    return default


def unwrap_budget(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict):
        return {}
    nested = data.get("budget")
    return nested if isinstance(nested, dict) else data


def budget_has_sku(budget: dict[str, Any], sku: str) -> bool:
    value = first_present(budget, ("budget_product_sku", "budget_product_skus"), "")
    if isinstance(value, list):
        return sku in value
    return str(value).casefold() == sku.casefold()


def budget_entity_matches(
    budget: dict[str, Any],
    *,
    cost_center_id: str,
    cost_center_name: str,
) -> bool:
    entity = str(first_present(budget, ("budget_entity_name", "entity_name"), "")).strip()
    return entity.casefold() in {cost_center_id.casefold(), cost_center_name.casefold()}


def is_cost_center_entity_validation_error(error: GitHubApiError) -> bool:
    if error.status_code not in {400, 422}:
        return False
    details = f"{error.message} {compact_json(error.body)}".casefold()
    has_entity_reference = (
        "budget_entity_name" in details
        or "entity name" in details
        or ("cost center" in details and "entity" in details)
    )
    has_validation_reason = any(
        phrase in details
        for phrase in (
            "invalid",
            "not found",
            "does not exist",
            "must be",
            "validation",
        )
    )
    return has_entity_reference and has_validation_reason


def chunk_resource_payloads(
    payload: dict[str, list[str]],
    *,
    batch_size: int = MAX_COST_CENTER_RESOURCES_PER_REQUEST,
) -> list[dict[str, list[str]]]:
    if batch_size <= 0 or batch_size > MAX_COST_CENTER_RESOURCES_PER_REQUEST:
        raise ValueError(
            f"batch_size must be between 1 and {MAX_COST_CENTER_RESOURCES_PER_REQUEST}"
        )
    flattened = [
        (resource_type, value)
        for resource_type, values in payload.items()
        for value in unique_preserving_order(values, case_insensitive=True)
    ]
    if not flattened:
        raise ValueError("At least one resource list is required")

    batches: list[dict[str, list[str]]] = []
    for start in range(0, len(flattened), batch_size):
        batch: dict[str, list[str]] = {}
        for resource_type, value in flattened[start : start + batch_size]:
            batch.setdefault(resource_type, []).append(value)
        batches.append(batch)
    return batches


class GitHubBillingClient:
    """Small, explicit wrapper around the GitHub REST APIs used by this repo."""

    def __init__(self, config: GitHubConfig) -> None:
        self.config = config
        self.session = self._create_session()

    def _create_session(self) -> requests.Session:
        session = requests.Session()
        retry = Retry(
            total=5,
            connect=5,
            read=5,
            backoff_factor=0.8,
            status_forcelist=[429, 500, 502, 503, 504],
            # Retrying a mutation after an ambiguous network failure can create
            # duplicate budgets or repeat a resource move. Retry safe reads only.
            allowed_methods=frozenset({"GET", "HEAD", "OPTIONS"}),
            respect_retry_after_header=True,
        )
        adapter = HTTPAdapter(max_retries=retry, pool_connections=10, pool_maxsize=20)
        session.mount("https://", adapter)
        session.verify = self.config.verify
        return session

    def _headers(self) -> dict[str, str]:
        return {
            "Authorization": f"Bearer {self.config.token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": self.config.api_version,
            "User-Agent": "github-billing-cost-center-apis/1.0",
        }

    def _enterprise_slug(self) -> str:
        return validate_slug(self.config.enterprise, "enterprise")

    def _request(
        self,
        method: str,
        endpoint: str,
        *,
        params: dict[str, Any] | None = None,
        json_body: dict[str, Any] | None = None,
        expected_status: tuple[int, ...] = (200,),
        source: str,
    ) -> Any:
        url = f"{self.config.base_url}{endpoint}"
        clean_params = {k: v for k, v in (params or {}).items() if v is not None}
        if self.config.dry_run:
            return self._dry_response(
                method=method,
                endpoint=endpoint,
                url=url,
                params=clean_params,
                json_body=json_body,
                source=source,
            )

        response = self.session.request(
            method=method,
            url=url,
            headers=self._headers(),
            params=clean_params or None,
            json=json_body,
            timeout=self.config.timeout,
        )

        if response.status_code not in expected_status:
            body: Any | None = None
            message = response.text[:800]
            try:
                body = response.json()
                message = body.get("message", message) if isinstance(body, dict) else message
            except ValueError:
                body = response.text
            raise GitHubApiError(method, url, response.status_code, message, body)

        if response.status_code == 204 or not response.text.strip():
            return {}
        return response.json()

    def _graphql_request(
        self,
        *,
        query: str,
        variables: dict[str, Any],
        operation_name: str,
        source: str,
    ) -> dict[str, Any]:
        payload = {
            "query": query,
            "variables": variables,
            "operationName": operation_name,
        }
        data = self._request(
            "POST",
            "/graphql",
            json_body=payload,
            expected_status=(200,),
            source=source,
        )
        if not isinstance(data, dict):
            raise GitHubApiError(
                "POST",
                f"{self.config.base_url}/graphql",
                200,
                "GraphQL response was not an object",
                data,
            )
        if not self.config.dry_run and data.get("errors"):
            messages = [
                str(error.get("message") or error)
                for error in data.get("errors", [])
                if isinstance(error, dict)
            ]
            if not messages:
                messages = [compact_json(data.get("errors"))]
            raise GitHubApiError(
                "POST",
                f"{self.config.base_url}/graphql",
                200,
                "; ".join(messages),
                data,
            )
        return data

    def _dry_response(
        self,
        *,
        method: str,
        endpoint: str,
        url: str,
        params: dict[str, Any],
        json_body: dict[str, Any] | None,
        source: str,
    ) -> dict[str, Any]:
        request = {
            "dry_run": True,
            "method": method,
            "endpoint": endpoint,
            "url": url,
            "params": params,
            "json": json_body,
            "source": source,
        }
        if endpoint.endswith("/settings/billing/budgets") and method == "GET":
            return {"budgets": [], "has_next_page": False, "total_count": 0, "request": request}
        if "/settings/billing/budgets/" in endpoint and method == "GET":
            return {"request": request}
        if endpoint.endswith("/settings/billing/cost-centers") and method == "GET":
            return {"costCenters": [], "request": request}
        if "/settings/billing/cost-centers/" in endpoint and method == "GET":
            return {
                "id": endpoint.rstrip("/").split("/")[-1],
                "name": "DRY_RUN_COST_CENTER",
                "resources": [],
                "request": request,
            }
        if endpoint.endswith("/settings/billing/reports") and method == "GET":
            return {"usage_report_exports": [], "request": request}
        if endpoint.endswith("/copilot/billing/seats"):
            return {"total_seats": 0, "seats": [], "request": request}
        if endpoint.endswith("/settings/billing/ai_credit/usage"):
            return {"usageItems": [], "request": request}
        if endpoint == "/user" and method == "GET":
            return {"login": self.config.alert_recipient_login or "DRY_RUN_LOGIN", "request": request}
        return request

    def _owner_budget_endpoint(self, owner_type: str, org: str | None = None) -> str:
        if owner_type == "enterprise":
            enterprise = validate_slug(self.config.enterprise, "enterprise")
            return f"/enterprises/{enterprise}/settings/billing/budgets"
        if owner_type == "organization":
            target_org = validate_slug(org or self.config.org, "organization")
            return f"/organizations/{target_org}/settings/billing/budgets"
        raise ValueError("owner_type must be 'enterprise' or 'organization'")

    # ------------------------------------------------------------------
    # Enterprise organization GraphQL APIs
    # Official source: GitHub GraphQL Enterprise Administration docs.
    # ------------------------------------------------------------------
    def get_enterprise_by_slug(self, enterprise_slug: str) -> dict[str, Any]:
        clean_slug = validate_slug(enterprise_slug, "enterprise_slug")
        if self.config.dry_run:
            return {
                "id": "DRY_RUN_ENTERPRISE_ID",
                "name": clean_slug,
                "slug": clean_slug,
                "dry_run": True,
            }
        query = """
        query EnterpriseNodeId($slug: String!) {
          enterprise(slug: $slug) {
            id
            name
          }
        }
        """
        data = self._graphql_request(
            query=query,
            variables={"slug": clean_slug},
            operation_name="EnterpriseNodeId",
            source=DOCS_GRAPHQL_ENTERPRISE_ADMIN,
        )
        enterprise = ((data.get("data") or {}).get("enterprise")) if isinstance(data, dict) else None
        if not isinstance(enterprise, dict) or not enterprise.get("id"):
            raise ValueError(f"Enterprise not found or not visible to token: {clean_slug!r}")
        return {
            "id": str(enterprise.get("id") or ""),
            "name": enterprise.get("name"),
            "slug": clean_slug,
        }

    def find_organization_by_login(self, login: str) -> dict[str, Any] | None:
        clean_login = validate_slug(login, "organization_login")
        if self.config.dry_run:
            return {
                "id": "DRY_RUN_ORGANIZATION_ID",
                "login": clean_login,
                "dry_run": True,
            }
        query = """
        query OrganizationReadback($login: String!) {
          organization(login: $login) {
            id
            login
            name
            url
          }
        }
        """
        data = self._graphql_request(
            query=query,
            variables={"login": clean_login},
            operation_name="OrganizationReadback",
            source=DOCS_GRAPHQL_ENTERPRISE_ADMIN,
        )
        organization = ((data.get("data") or {}).get("organization")) if isinstance(data, dict) else None
        return organization if isinstance(organization, dict) else None

    def create_enterprise_organization(
        self,
        *,
        login: str,
        billing_email: str,
        admin_logins: list[str],
        enterprise_id: str | None = None,
        enterprise_slug: str | None = None,
    ) -> dict[str, Any]:
        if enterprise_id and enterprise_slug:
            raise ValueError("Provide only one of enterprise_id or enterprise_slug")
        clean_login = validate_slug(login, "organization_login")
        clean_billing_email = validate_billing_email(billing_email)
        clean_admin_logins = [
            validate_login(value)
            for value in unique_preserving_order(admin_logins, case_insensitive=True)
        ]
        if not clean_admin_logins:
            raise ValueError("At least one organization admin login is required")

        resolved_enterprise_slug = (
            validate_slug(enterprise_slug, "enterprise_slug") if enterprise_slug else None
        )
        enterprise_lookup: dict[str, Any] | None = None
        if enterprise_id:
            resolved_enterprise_id = validate_graphql_id(enterprise_id, "enterprise_id")
        else:
            enterprise_lookup = self.get_enterprise_by_slug(
                resolved_enterprise_slug or self._enterprise_slug()
            )
            resolved_enterprise_id = validate_graphql_id(
                str(enterprise_lookup.get("id") or ""),
                "enterprise_id",
            )
            resolved_enterprise_slug = str(
                enterprise_lookup.get("slug") or resolved_enterprise_slug or self._enterprise_slug()
            )

        if not self.config.dry_run:
            existing = self.find_organization_by_login(clean_login)
            if existing:
                return {
                    "ok": False,
                    "dry_run": False,
                    "operation": "already_exists",
                    "organization_login": clean_login,
                    "organization_id": existing.get("id"),
                    "message": f"Organization {clean_login!r} already exists or is visible to this token",
                    "existing_organization": existing,
                    "verified": False,
                    "verification_status": "not_created_existing_organization",
                }

        mutation = """
        mutation createOrg($enterpriseId: ID!, $adminLogins: [String!]!, $billingEmail: String!, $login: String!) {
          createEnterpriseOrganization(input: {
            enterpriseId: $enterpriseId,
            adminLogins: $adminLogins,
            billingEmail: $billingEmail,
            login: $login,
            profileName: $login
          }) {
            enterprise {
              id
            }
            organization {
              id
              login
            }
          }
        }
        """
        variables = {
            "enterpriseId": resolved_enterprise_id,
            "adminLogins": clean_admin_logins,
            "billingEmail": clean_billing_email,
            "login": clean_login,
        }
        response = self._graphql_request(
            query=mutation,
            variables=variables,
            operation_name="createOrg",
            source=DOCS_GRAPHQL_ENTERPRISE_ADMIN,
        )
        if self.config.dry_run:
            return {
                "ok": True,
                "dry_run": True,
                "operation": "planned",
                "enterprise_id": resolved_enterprise_id,
                "enterprise_slug": resolved_enterprise_slug,
                "organization_login": clean_login,
                "profile_name": clean_login,
                "admin_logins": clean_admin_logins,
                "billing_email": clean_billing_email,
                "verified": False,
                "verification_status": "not_performed_dry_run",
                "response": response,
            }

        payload = ((response.get("data") or {}).get("createEnterpriseOrganization")) if isinstance(response, dict) else None
        if not isinstance(payload, dict):
            raise RuntimeError("GitHub did not return createEnterpriseOrganization data")
        enterprise = payload.get("enterprise") if isinstance(payload.get("enterprise"), dict) else {}
        organization = payload.get("organization") if isinstance(payload.get("organization"), dict) else {}
        organization_id = str(organization.get("id") or "")
        created_login = str(organization.get("login") or "")
        readback = self.find_organization_by_login(clean_login) or {}
        readback_login = str(readback.get("login") or "")
        readback_id = str(readback.get("id") or "")
        verified = (
            str(enterprise.get("id") or "") == resolved_enterprise_id
            and bool(organization_id)
            and created_login.casefold() == clean_login.casefold()
            and readback_login.casefold() == clean_login.casefold()
            and (not readback_id or readback_id == organization_id)
        )
        return {
            "ok": verified,
            "dry_run": False,
            "operation": "created",
            "enterprise_id": resolved_enterprise_id,
            "enterprise_slug": resolved_enterprise_slug,
            "enterprise_lookup": enterprise_lookup,
            "organization_id": organization_id or readback_id or None,
            "organization_login": clean_login,
            "created_organization_login": created_login,
            "profile_name": clean_login,
            "admin_logins": clean_admin_logins,
            "billing_email": clean_billing_email,
            "verified": verified,
            "verification_status": "verified" if verified else "failed",
            "readback": readback,
        }

    @staticmethod
    def _monthly_reset_amount(value: Any, label: str) -> int:
        if isinstance(value, bool) or value is None:
            raise ValueError(f"{label} must be a non-negative whole-dollar amount")
        try:
            amount = Decimal(str(value))
        except (InvalidOperation, ValueError) as exc:
            raise ValueError(
                f"{label} must be a non-negative whole-dollar amount"
            ) from exc
        if not amount.is_finite() or amount < 0 or amount != amount.to_integral_value():
            raise ValueError(f"{label} must be a non-negative whole-dollar amount")
        return int(amount)

    @staticmethod
    def _read_monthly_reset_json(path_value: str, label: str) -> tuple[Path, Any, str]:
        if not isinstance(path_value, str) or not path_value.strip():
            raise ValueError(f"{label} is required")
        try:
            path = Path(path_value).expanduser().resolve(strict=True)
        except (OSError, RuntimeError) as exc:
            raise ValueError(f"Unable to resolve {label}: {path_value!r}") from exc
        if not path.is_file():
            raise ValueError(f"{label} is not a regular file: {path}")
        size = path.stat().st_size
        if size > MAX_MONTHLY_RESET_INPUT_BYTES:
            raise ValueError(
                f"{label} exceeds {MAX_MONTHLY_RESET_INPUT_BYTES} bytes: {path}"
            )
        raw = path.read_bytes()
        try:
            payload = json.loads(raw.decode("utf-8-sig"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError(f"{label} must contain valid UTF-8 JSON: {path}") from exc
        return path, payload, hashlib.sha256(raw).hexdigest()

    @staticmethod
    def _monthly_reset_period(value: str) -> tuple[int, int, str]:
        match = re.fullmatch(r"(\d{4})-(\d{2})", str(value or ""))
        if not match:
            raise ValueError("reset_month must use YYYY-MM")
        year = int(match.group(1))
        month = int(match.group(2))
        if year < 2000 or month < 1 or month > 12:
            raise ValueError("reset_month must use a valid YYYY-MM value")
        return year, month, f"{year:04d}-{month:02d}"

    @staticmethod
    def _monthly_reset_timestamp(value: Any, label: str) -> datetime:
        if not isinstance(value, str) or not value.strip():
            raise ValueError(f"{label} must be an RFC 3339 timestamp")
        normalized = value.strip()
        if normalized.endswith("Z"):
            normalized = f"{normalized[:-1]}+00:00"
        try:
            parsed = datetime.fromisoformat(normalized)
        except ValueError as exc:
            raise ValueError(f"{label} must be an RFC 3339 timestamp") from exc
        if parsed.tzinfo is None:
            raise ValueError(f"{label} must include a timezone")
        return parsed.astimezone(timezone.utc)

    @staticmethod
    def _monthly_reset_output_directory(report_dir: str | None) -> Path:
        configured = report_dir or os.getenv("GITHUB_OUTPUT_DIR") or "Export-Data"
        output_dir = Path(configured).expanduser()
        if not output_dir.is_absolute():
            output_dir = Path.cwd() / output_dir
        output_dir = output_dir.resolve()
        output_dir.mkdir(parents=True, exist_ok=True)
        if not output_dir.is_dir():
            raise ValueError(f"Monthly reset report directory is invalid: {output_dir}")
        return output_dir

    @staticmethod
    def _write_monthly_reset_json(path: Path, payload: Any) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=f".{path.name}.",
            suffix=".tmp",
            dir=path.parent,
        )
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
                json.dump(payload, handle, indent=2, sort_keys=True, ensure_ascii=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary_name, 0o600)
            os.replace(temporary_name, path)
        except BaseException:
            try:
                os.unlink(temporary_name)
            except FileNotFoundError:
                pass
            raise

    def _load_monthly_reset_baseline_file(self, path_value: str) -> dict[str, Any]:
        path, payload, sha256 = self._read_monthly_reset_json(
            path_value,
            "baseline_file",
        )
        if not isinstance(payload, dict):
            raise ValueError("baseline_file root must be a JSON object")
        if payload.get("schema_version") != MONTHLY_RESET_SCHEMA_VERSION:
            raise ValueError(
                f"baseline_file schema_version must be {MONTHLY_RESET_SCHEMA_VERSION}"
            )
        rows = payload.get("cost_centers")
        if not isinstance(rows, list) or not rows:
            raise ValueError("baseline_file cost_centers must be a non-empty array")

        normalized_rows: list[dict[str, Any]] = []
        seen_ids: set[str] = set()
        seen_names: set[str] = set()
        for index, row in enumerate(rows):
            label = f"baseline_file cost_centers[{index}]"
            if not isinstance(row, dict):
                raise ValueError(f"{label} must be an object")
            raw_id = str(row.get("cost_center_id") or "").strip()
            raw_name = str(row.get("cost_center_name") or "").strip()
            if not raw_id and not raw_name:
                raise ValueError(
                    f"{label} must include cost_center_id or cost_center_name"
                )
            cost_center_id = validate_resource_id(raw_id, "cost_center_id") if raw_id else None
            cost_center_name = validate_cost_center_name(raw_name) if raw_name else None
            amount = self._monthly_reset_amount(
                row.get("initial_budget_amount"),
                f"{label}.initial_budget_amount",
            )
            if cost_center_id:
                if cost_center_id in seen_ids:
                    raise ValueError(
                        f"baseline_file contains duplicate cost_center_id {cost_center_id!r}"
                    )
                seen_ids.add(cost_center_id)
            if cost_center_name:
                normalized_name = cost_center_name.casefold()
                if normalized_name in seen_names:
                    raise ValueError(
                        f"baseline_file contains duplicate cost_center_name {cost_center_name!r}"
                    )
                seen_names.add(normalized_name)
            normalized_rows.append(
                {
                    "cost_center_id": cost_center_id,
                    "cost_center_name": cost_center_name,
                    "initial_budget_amount": amount,
                }
            )
        return {
            "kind": "baseline_file",
            "path": str(path),
            "sha256": sha256,
            "rows": normalized_rows,
        }

    def _load_monthly_reset_audit_file(
        self,
        path_value: str,
        *,
        reset_month: str,
    ) -> dict[str, Any]:
        reset_year, reset_month_number, normalized_reset_month = self._monthly_reset_period(
            reset_month
        )
        prior_month_last_day = date(reset_year, reset_month_number, 1) - timedelta(days=1)
        expected_period = f"{prior_month_last_day.year:04d}-{prior_month_last_day.month:02d}"
        path, payload, sha256 = self._read_monthly_reset_json(
            path_value,
            "prior_month_audit_file",
        )
        if not isinstance(payload, dict):
            raise ValueError("prior_month_audit_file root must be a JSON object")
        if payload.get("schema_version") != MONTHLY_RESET_SCHEMA_VERSION:
            raise ValueError(
                "prior_month_audit_file schema_version must be "
                f"{MONTHLY_RESET_SCHEMA_VERSION}"
            )
        if payload.get("period") != expected_period:
            raise ValueError(
                "prior_month_audit_file period must be the month immediately before "
                f"reset_month {normalized_reset_month}: expected {expected_period!r}"
            )
        if payload.get("collection_status") != "complete":
            raise ValueError(
                "prior_month_audit_file collection_status must be 'complete'"
            )
        rows = payload.get("events")
        if not isinstance(rows, list):
            raise ValueError("prior_month_audit_file events must be an array")

        normalized_events: list[dict[str, Any]] = []
        seen_events: set[tuple[Any, ...]] = set()
        valid_actions = {
            "billing.budget_create",
            "billing.budget_update",
            "billing.budget_delete",
        }
        for index, row in enumerate(rows):
            label = f"prior_month_audit_file events[{index}]"
            if not isinstance(row, dict):
                raise ValueError(f"{label} must be an object")
            budget_scope = row.get("budget_scope")
            if budget_scope not in VALID_BUDGET_SCOPES:
                raise ValueError(f"{label}.budget_scope is invalid")
            if budget_scope != "multi_user_cost_center":
                continue
            action = str(row.get("action") or "")
            if action not in valid_actions:
                raise ValueError(f"{label}.action is unsupported: {action!r}")
            budget_id = validate_resource_id(
                str(row.get("budget_id") or ""),
                f"{label}.budget_id",
            )
            timestamp = self._monthly_reset_timestamp(row.get("timestamp"), f"{label}.timestamp")
            if timestamp.year != prior_month_last_day.year or timestamp.month != prior_month_last_day.month:
                raise ValueError(
                    f"{label}.timestamp is outside declared period {expected_period}"
                )
            target_amount = None
            old_target_amount = None
            if action in {"billing.budget_create", "billing.budget_update"}:
                target_amount = self._monthly_reset_amount(
                    row.get("target_amount"),
                    f"{label}.target_amount",
                )
            if action == "billing.budget_update":
                old_target_amount = self._monthly_reset_amount(
                    row.get("old_target_amount"),
                    f"{label}.old_target_amount",
                )
            signature = (
                timestamp.isoformat(),
                action,
                budget_id,
                old_target_amount,
                target_amount,
            )
            if signature in seen_events:
                raise ValueError(f"{label} duplicates an earlier audit event")
            seen_events.add(signature)
            normalized_events.append(
                {
                    "timestamp": timestamp.isoformat(),
                    "action": action,
                    "budget_id": budget_id,
                    "old_target_amount": old_target_amount,
                    "target_amount": target_amount,
                }
            )
        return {
            "kind": "prior_month_audit_file",
            "path": str(path),
            "sha256": sha256,
            "period": expected_period,
            "reset_month": normalized_reset_month,
            "collection_status": "complete",
            "events": normalized_events,
        }

    # ------------------------------------------------------------------
    # Budget APIs
    # Official source: GitHub REST Billing Budgets docs.
    # ------------------------------------------------------------------
    def list_budgets(
        self,
        *,
        owner_type: str = "enterprise",
        org: str | None = None,
        scope: str | None = None,
        user: str | None = None,
        page: int = 1,
        per_page: int = 100,
        all_pages: bool = False,
    ) -> dict[str, Any]:
        endpoint = self._owner_budget_endpoint(owner_type, org)
        all_budgets: list[dict[str, Any]] = []
        next_page = page
        total_count = 0
        has_next = False

        while True:
            data = self._request(
                "GET",
                endpoint,
                params={"page": next_page, "per_page": per_page, "scope": scope, "user": user},
                source=DOCS_BUDGETS,
            )
            budgets = data.get("budgets", []) if isinstance(data, dict) else []
            all_budgets.extend(budgets)
            total_count = data.get("total_count", len(all_budgets)) if isinstance(data, dict) else len(all_budgets)
            has_next = bool(data.get("has_next_page")) if isinstance(data, dict) else False
            if not all_pages or not has_next:
                break
            next_page += 1

        result = {
            "budgets": all_budgets,
            "has_next_page": has_next,
            "total_count": total_count,
            "pages_fetched": next_page - page + 1,
        }
        if self.config.dry_run:
            result["dry_run"] = True
        return result

    def get_budget(
        self,
        budget_id: str,
        *,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any]:
        budget_id = validate_resource_id(budget_id, "budget_id")
        endpoint = f"{self._owner_budget_endpoint(owner_type, org)}/{budget_id}"
        return self._request("GET", endpoint, source=DOCS_BUDGETS)

    def create_budget(
        self,
        *,
        amount: int,
        scope: str,
        budget_type: str,
        sku: str,
        entity_name: str = "",
        user: str | None = None,
        prevent: bool = True,
        will_alert: bool = False,
        alert_recipients: list[str] | None = None,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any]:
        if prevent is not True:
            raise ValueError("prevent_further_usage is enforced and cannot be disabled")
        validate_budget_payload(
            amount=amount,
            scope=scope,
            budget_type=budget_type,
            sku=sku,
            user=user,
            prevent=True,
        )
        clean_alert_recipients = [
            validate_login(login)
            for login in unique_preserving_order(
                alert_recipients or [],
                case_insensitive=True,
            )
        ]
        payload: dict[str, Any] = {
            "budget_amount": amount,
            "prevent_further_usage": True,
            "budget_scope": scope,
            "budget_entity_name": entity_name,
            "budget_type": budget_type,
            "budget_product_sku": sku,
            "budget_alerting": {
                "will_alert": will_alert,
                "alert_recipients": clean_alert_recipients,
            },
        }
        if scope == "user":
            payload["user"] = user
        return self._request(
            "POST",
            self._owner_budget_endpoint(owner_type, org),
            json_body=payload,
            source=DOCS_BUDGETS,
        )

    def create_user_budget(
        self,
        *,
        user: str,
        amount: int,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any]:
        clean_user = validate_login(user)
        return self.create_budget(
            amount=amount,
            scope="user",
            entity_name="",
            user=clean_user,
            budget_type="BundlePricing",
            sku="ai_credits",
            prevent=True,
            will_alert=False,
            alert_recipients=[],
            owner_type=owner_type,
            org=org,
        )

    def update_budget(
        self,
        budget_id: str,
        patch: dict[str, Any],
        *,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any]:
        budget_id = validate_resource_id(budget_id, "budget_id")
        if not isinstance(patch, dict) or not patch:
            raise ValueError("patch body must not be empty")
        if patch.get("prevent_further_usage") is False:
            raise ValueError("prevent_further_usage is enforced and cannot be disabled")
        safe_patch = dict(patch)
        safe_patch["prevent_further_usage"] = True
        endpoint = f"{self._owner_budget_endpoint(owner_type, org)}/{budget_id}"
        return self._request("PATCH", endpoint, json_body=safe_patch, source=DOCS_BUDGETS)

    def delete_budget(
        self,
        budget_id: str,
        *,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any]:
        budget_id = validate_resource_id(budget_id, "budget_id")
        endpoint = f"{self._owner_budget_endpoint(owner_type, org)}/{budget_id}"
        return self._request("DELETE", endpoint, source=DOCS_BUDGETS)

    def find_user_budget(
        self,
        user: str,
        *,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any] | None:
        data = self.list_budgets(
            owner_type=owner_type,
            org=org,
            scope="user",
            user=user,
            all_pages=True,
        )
        wanted = normalize_login(user)
        for budget in data.get("budgets", []):
            budget_user = normalize_login(
                first_present(budget, ("user", "budget_entity_name", "target_name"), "")
            )
            sku = first_present(budget, ("budget_product_sku", "budget_product_skus"), "")
            sku_match = sku == "ai_credits" or (isinstance(sku, list) and "ai_credits" in sku)
            if (
                budget.get("budget_scope") == "user"
                and budget.get("budget_type") == "BundlePricing"
                and budget_user == wanted
                and sku_match
            ):
                return budget
        return None

    def increase_user_budget(
        self,
        *,
        user: str,
        new_amount: int | None = None,
        increase_by: int | None = None,
        budget_id: str | None = None,
        owner_type: str = "enterprise",
        org: str | None = None,
    ) -> dict[str, Any]:
        if not user and not budget_id:
            raise ValueError("user or budget_id is required")
        if new_amount is None and increase_by is None:
            raise ValueError("new_amount or increase_by is required")
        if new_amount is not None and increase_by is not None:
            raise ValueError("provide only one of new_amount or increase_by")

        if self.config.dry_run and not budget_id:
            patch = {"budget_amount": new_amount or f"current + {increase_by}", "prevent_further_usage": True}
            return {
                "dry_run": True,
                "steps": [
                    "GET exact user budget by scope=user and user login",
                    "PATCH the returned budget_id with the computed budget_amount",
                ],
                "patch_template": patch,
                "source": DOCS_BUDGETS,
            }

        current = (
            self.get_budget(budget_id, owner_type=owner_type, org=org)
            if budget_id
            else self.find_user_budget(user, owner_type=owner_type, org=org)
        )
        if not current:
            raise ValueError(f"No existing ai_credits user budget found for {user}")

        current_amount = int(float(current.get("budget_amount") or 0))
        target_amount = new_amount if new_amount is not None else current_amount + int(increase_by or 0)
        if target_amount <= current_amount:
            raise ValueError(
                f"target budget must be greater than current budget {current_amount}; got {target_amount}"
            )
        patch = {"budget_amount": target_amount, "prevent_further_usage": True}
        return self.update_budget(
            current["id"],
            patch,
            owner_type=owner_type,
            org=org,
        )

    def bulk_create_user_budgets(
        self,
        *,
        users: list[str],
        amount: int = DEFAULT_USER_BUDGET_AMOUNT,
        update_existing: bool = False,
    ) -> dict[str, Any]:
        requested_users = [
            validate_login(login)
            for login in unique_preserving_order(users, case_insensitive=True)
        ]
        if not requested_users:
            raise ValueError("At least one user is required")
        if amount <= 0:
            raise ValueError("amount must be a positive whole-dollar value")

        current = self.list_budgets(scope="user", all_pages=True)
        budgets_by_user: dict[str, list[dict[str, Any]]] = {}
        for budget in current.get("budgets", []):
            login = normalize_login(
                first_present(budget, ("user", "budget_entity_name", "target_name"), "")
            )
            if (
                login
                and budget.get("budget_scope") == "user"
                and budget.get("budget_type") == "BundlePricing"
                and budget_has_sku(budget, "ai_credits")
            ):
                budgets_by_user.setdefault(login, []).append(budget)

        results: list[dict[str, Any]] = []
        for user in requested_users:
            existing_matches = budgets_by_user.get(normalize_login(user), [])
            if len(existing_matches) > 1:
                results.append(
                    {
                        "user": user,
                        "status": "failed",
                        "error_type": "AmbiguousBudget",
                        "error": (
                            f"{len(existing_matches)} bundled AI-credit user budgets matched"
                        ),
                        "budget_ids": [
                            str(item.get("id") or "") for item in existing_matches
                        ],
                        "verified": False,
                    }
                )
                continue
            existing = existing_matches[0] if existing_matches else None
            try:
                if existing and not update_existing:
                    matches_policy = (
                        safe_float(existing.get("budget_amount")) == float(amount)
                        and existing.get("prevent_further_usage") is True
                    )
                    results.append(
                        {
                            "user": user,
                            "status": "already_exists" if matches_policy else "existing_budget_differs",
                            "budget_id": existing.get("id"),
                            "budget_amount": safe_float(existing.get("budget_amount")),
                            "prevent_further_usage": existing.get("prevent_further_usage"),
                            "verified": matches_policy and not self.config.dry_run,
                        }
                    )
                    continue

                if existing:
                    response = self.update_budget(
                        str(existing.get("id") or ""),
                        {"budget_amount": amount, "prevent_further_usage": True},
                    )
                    status = "updated"
                else:
                    response = self.create_user_budget(user=user, amount=amount)
                    status = "planned" if self.config.dry_run else "created"

                created_budget = unwrap_budget(response)
                budget_id = str(
                    created_budget.get("id")
                    or (existing.get("id") if existing else "")
                    or ""
                )
                verified_budget = created_budget
                if budget_id and not self.config.dry_run:
                    verified_budget = unwrap_budget(self.get_budget(budget_id))
                verified = (
                    not self.config.dry_run
                    and normalize_login(
                        first_present(
                            verified_budget,
                            ("user", "budget_entity_name", "target_name"),
                            user,
                        )
                    )
                    == normalize_login(user)
                    and verified_budget.get("budget_scope") == "user"
                    and budget_has_sku(verified_budget, "ai_credits")
                    and safe_float(verified_budget.get("budget_amount")) == float(amount)
                    and verified_budget.get("prevent_further_usage") is True
                )
                results.append(
                    {
                        "user": user,
                        "status": status,
                        "budget_id": budget_id or None,
                        "budget_amount": amount,
                        "prevent_further_usage": True,
                        "verified": verified,
                        "response": response if self.config.dry_run else None,
                    }
                )
            except (GitHubApiError, ValueError, requests.RequestException) as exc:
                results.append(
                    {
                        "user": user,
                        "status": "failed",
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                        "verified": False,
                    }
                )

        failed = sum(1 for item in results if item["status"] == "failed")
        differing = sum(1 for item in results if item["status"] == "existing_budget_differs")
        verified_count = sum(1 for item in results if item.get("verified") is True)
        unverified = len(results) - verified_count
        return {
            "ok": failed == 0
            and differing == 0
            and (self.config.dry_run or unverified == 0),
            "dry_run": self.config.dry_run,
            "summary": {
                "requested": len(requested_users),
                "created": sum(1 for item in results if item["status"] == "created"),
                "planned": sum(1 for item in results if item["status"] == "planned"),
                "updated": sum(1 for item in results if item["status"] == "updated"),
                "already_exists": sum(1 for item in results if item["status"] == "already_exists"),
                "existing_budget_differs": differing,
                "failed": failed,
                "verified": verified_count,
                "unverified": unverified,
                "amount_usd": amount,
                "prevent_further_usage": True,
            },
            "results": results,
        }

    def get_authenticated_user(self) -> dict[str, Any]:
        return self._request("GET", "/user", source=DOCS_AUTHENTICATED_USER)

    def resolve_alert_recipient(self, supplied_login: str | None = None) -> str:
        configured = (supplied_login or self.config.alert_recipient_login).strip()
        if configured:
            return validate_login(configured)
        authenticated_user = self.get_authenticated_user()
        login = authenticated_user.get("login") if isinstance(authenticated_user, dict) else None
        if not isinstance(login, str) or not login.strip():
            raise ValueError(
                "Unable to resolve the alert recipient; provide --alert-recipient "
                "or set GITHUB_ALERT_RECIPIENT"
            )
        return validate_login(login)

    def resolve_cost_center(
        self,
        *,
        cost_center_id: str | None = None,
        cost_center_name: str | None = None,
        state: str = "active",
    ) -> dict[str, Any]:
        if bool(cost_center_id) == bool(cost_center_name):
            raise ValueError("Provide exactly one of cost_center_id or cost_center_name")
        if cost_center_id:
            clean_id = validate_resource_id(cost_center_id, "cost_center_id")
            details = self.get_cost_center(clean_id)
            if not isinstance(details, dict) or not details.get("id"):
                raise ValueError(f"Cost center not found: {clean_id}")
            return details

        wanted_name = validate_cost_center_name(cost_center_name or "")
        if self.config.dry_run:
            return {"id": "DRY_RUN_COST_CENTER_ID", "name": wanted_name, "state": state, "resources": []}
        matches = [
            item
            for item in extract_cost_centers(self.list_cost_centers(state=state))
            if str(item.get("name") or "").strip().casefold() == wanted_name.casefold()
        ]
        if not matches:
            raise ValueError(f"No {state} cost center found with exact name {wanted_name!r}")
        if len(matches) > 1:
            raise ValueError(f"Multiple {state} cost centers matched exact name {wanted_name!r}")
        cost_center_id_value = validate_resource_id(
            str(matches[0].get("id") or ""),
            "cost_center_id",
        )
        return self.get_cost_center(cost_center_id_value) if cost_center_id_value else matches[0]

    def find_cost_center_ai_credit_budgets(
        self,
        *,
        cost_center_id: str,
        cost_center_name: str,
        scope: str,
    ) -> list[dict[str, Any]]:
        if scope not in {"cost_center", "multi_user_cost_center"}:
            raise ValueError("scope must be cost_center or multi_user_cost_center")
        budgets = self.list_budgets(all_pages=True).get("budgets", [])
        return [
            budget
            for budget in budgets
            if budget.get("budget_scope") == scope
            and budget.get("budget_type") == "BundlePricing"
            and budget_has_sku(budget, "ai_credits")
            and budget_entity_matches(
                budget,
                cost_center_id=cost_center_id,
                cost_center_name=cost_center_name,
            )
        ]

    def find_cost_center_budgets(
        self,
        *,
        cost_center_id: str,
        cost_center_name: str,
    ) -> list[dict[str, Any]]:
        return self.find_cost_center_ai_credit_budgets(
            cost_center_id=cost_center_id,
            cost_center_name=cost_center_name,
            scope="cost_center",
        )

    def assign_cost_center_budget(
        self,
        *,
        amount: int,
        alert_recipient: str | None = None,
        cost_center_id: str | None = None,
        cost_center_name: str | None = None,
    ) -> dict[str, Any]:
        if amount <= 0:
            raise ValueError("amount must be a positive whole-dollar value")
        cost_center = self.resolve_cost_center(
            cost_center_id=cost_center_id,
            cost_center_name=cost_center_name,
        )
        resolved_id = validate_resource_id(
            str(cost_center.get("id") or ""),
            "cost_center_id",
        )
        resolved_name = validate_cost_center_name(str(cost_center.get("name") or cost_center_name or ""))
        recipient = self.resolve_alert_recipient(alert_recipient)
        existing = self.find_cost_center_budgets(
            cost_center_id=resolved_id,
            cost_center_name=resolved_name,
        )
        if len(existing) > 1:
            raise ValueError(
                f"Multiple bundled AI-credit budgets match cost center {resolved_name!r}; "
                "remove the duplicate budgets by ID before assigning"
            )

        alerting = {"will_alert": True, "alert_recipients": [recipient]}
        if existing:
            budget_id = str(existing[0].get("id") or "")
            response = self.update_budget(
                budget_id,
                {
                    "budget_amount": amount,
                    "prevent_further_usage": True,
                    "budget_alerting": alerting,
                },
            )
            operation = "updated"
        else:
            entity_reference_used = "id"
            try:
                response = self.create_budget(
                    amount=amount,
                    scope="cost_center",
                    # GitHub's cost-at-scale tutorial uses the UUID here.
                    entity_name=resolved_id,
                    budget_type="BundlePricing",
                    sku="ai_credits",
                    prevent=True,
                    will_alert=True,
                    alert_recipients=[recipient],
                )
            except GitHubApiError as exc:
                if not is_cost_center_entity_validation_error(exc):
                    raise
                # The latest generic schema describes this field as the entity
                # name. Retry only after GitHub explicitly rejects the ID as an
                # entity reference; a validation response did not create a budget.
                entity_reference_used = "name_after_id_validation_rejection"
                response = self.create_budget(
                    amount=amount,
                    scope="cost_center",
                    entity_name=resolved_name,
                    budget_type="BundlePricing",
                    sku="ai_credits",
                    prevent=True,
                    will_alert=True,
                    alert_recipients=[recipient],
                )
            created = unwrap_budget(response)
            budget_id = str(created.get("id") or "")
            operation = "planned" if self.config.dry_run else "created"

        verified_budget = unwrap_budget(response)
        if budget_id and not self.config.dry_run:
            verified_budget = unwrap_budget(self.get_budget(budget_id))
        verified = (
            not self.config.dry_run
            and verified_budget.get("budget_scope") == "cost_center"
            and verified_budget.get("budget_type") == "BundlePricing"
            and budget_has_sku(verified_budget, "ai_credits")
            and budget_entity_matches(
                verified_budget,
                cost_center_id=resolved_id,
                cost_center_name=resolved_name,
            )
            and safe_float(verified_budget.get("budget_amount")) == float(amount)
            and verified_budget.get("prevent_further_usage") is True
            and bool((verified_budget.get("budget_alerting") or {}).get("will_alert"))
            and recipient
            in ((verified_budget.get("budget_alerting") or {}).get("alert_recipients") or [])
        )
        return {
            "ok": self.config.dry_run or verified,
            "dry_run": self.config.dry_run,
            "operation": operation,
            "cost_center_id": resolved_id,
            "cost_center_name": resolved_name,
            "budget_id": budget_id or None,
            "budget_amount": amount,
            "budget_scope": "cost_center",
            "budget_type": "BundlePricing",
            "budget_product_sku": "ai_credits",
            "budget_entity_reference": (
                "existing_budget"
                if existing
                else entity_reference_used
            ),
            "prevent_further_usage": True,
            "budget_alerting": alerting,
            "verified": verified,
            "verification_status": (
                "not_performed_dry_run" if self.config.dry_run else "verified" if verified else "failed"
            ),
            "response": response if self.config.dry_run else None,
        }

    def assign_cost_center_per_user_budget(
        self,
        *,
        amount: int,
        cost_center_id: str | None = None,
        cost_center_name: str | None = None,
    ) -> dict[str, Any]:
        if amount < 0:
            raise ValueError("amount must be a whole-dollar value >= 0")
        cost_center = self.resolve_cost_center(
            cost_center_id=cost_center_id,
            cost_center_name=cost_center_name,
        )
        resolved_id = validate_resource_id(
            str(cost_center.get("id") or ""),
            "cost_center_id",
        )
        resolved_name = validate_cost_center_name(str(cost_center.get("name") or cost_center_name or ""))
        existing = self.find_cost_center_ai_credit_budgets(
            cost_center_id=resolved_id,
            cost_center_name=resolved_name,
            scope="multi_user_cost_center",
        )
        if len(existing) > 1:
            raise ValueError(
                f"Multiple per-user AI-credit budgets match cost center {resolved_name!r}; "
                "remove the duplicate budgets by ID before assigning"
            )

        alerting = {"will_alert": False, "alert_recipients": []}
        if existing:
            budget_id = str(existing[0].get("id") or "")
            response = self.update_budget(
                budget_id,
                {
                    "budget_amount": amount,
                    "prevent_further_usage": True,
                    "budget_alerting": alerting,
                },
            )
            operation = "updated"
            entity_reference_used = "existing_budget"
        else:
            entity_reference_used = "id"
            try:
                response = self.create_budget(
                    amount=amount,
                    scope="multi_user_cost_center",
                    entity_name=resolved_id,
                    budget_type="BundlePricing",
                    sku="ai_credits",
                    prevent=True,
                    will_alert=False,
                    alert_recipients=[],
                )
            except GitHubApiError as exc:
                if not is_cost_center_entity_validation_error(exc):
                    raise
                entity_reference_used = "name_after_id_validation_rejection"
                response = self.create_budget(
                    amount=amount,
                    scope="multi_user_cost_center",
                    entity_name=resolved_name,
                    budget_type="BundlePricing",
                    sku="ai_credits",
                    prevent=True,
                    will_alert=False,
                    alert_recipients=[],
                )
            created = unwrap_budget(response)
            budget_id = str(created.get("id") or "")
            operation = "planned" if self.config.dry_run else "created"

        verified_budget = unwrap_budget(response)
        if budget_id and not self.config.dry_run:
            verified_budget = unwrap_budget(self.get_budget(budget_id))
        budget_alerting = verified_budget.get("budget_alerting") or {}
        verified = (
            not self.config.dry_run
            and verified_budget.get("budget_scope") == "multi_user_cost_center"
            and verified_budget.get("budget_type") == "BundlePricing"
            and budget_has_sku(verified_budget, "ai_credits")
            and budget_entity_matches(
                verified_budget,
                cost_center_id=resolved_id,
                cost_center_name=resolved_name,
            )
            and safe_float(verified_budget.get("budget_amount")) == float(amount)
            and verified_budget.get("prevent_further_usage") is True
            and budget_alerting.get("will_alert") is False
            and not (budget_alerting.get("alert_recipients") or [])
        )
        return {
            "ok": self.config.dry_run or verified,
            "dry_run": self.config.dry_run,
            "operation": operation,
            "cost_center_id": resolved_id,
            "cost_center_name": resolved_name,
            "budget_id": budget_id or None,
            "budget_amount": amount,
            "budget_scope": "multi_user_cost_center",
            "budget_type": "BundlePricing",
            "budget_product_sku": "ai_credits",
            "budget_entity_reference": entity_reference_used,
            "prevent_further_usage": True,
            "budget_alerting": alerting,
            "verified": verified,
            "verification_status": (
                "not_performed_dry_run" if self.config.dry_run else "verified" if verified else "failed"
            ),
            "response": response if self.config.dry_run else None,
        }

    def remove_cost_center_budget(
        self,
        *,
        budget_id: str | None = None,
        cost_center_id: str | None = None,
        cost_center_name: str | None = None,
    ) -> dict[str, Any]:
        cost_center = self.resolve_cost_center(
            cost_center_id=cost_center_id,
            cost_center_name=cost_center_name,
        )
        resolved_id = validate_resource_id(
            str(cost_center.get("id") or ""),
            "cost_center_id",
        )
        resolved_name = validate_cost_center_name(str(cost_center.get("name") or cost_center_name or ""))

        if budget_id:
            budget_id = validate_resource_id(budget_id, "budget_id")
            if self.config.dry_run:
                matches = [{"id": budget_id}]
            else:
                candidate = unwrap_budget(self.get_budget(budget_id))
                matches = (
                    [candidate]
                    if candidate.get("budget_scope") == "cost_center"
                    and candidate.get("budget_type") == "BundlePricing"
                    and budget_has_sku(candidate, "ai_credits")
                    and budget_entity_matches(
                        candidate,
                        cost_center_id=resolved_id,
                        cost_center_name=resolved_name,
                    )
                    else []
                )
                if not matches:
                    raise ValueError(
                        f"Budget {budget_id!r} is not the bundled AI-credit budget for "
                        f"cost center {resolved_name!r}"
                    )
        else:
            matches = self.find_cost_center_budgets(
                cost_center_id=resolved_id,
                cost_center_name=resolved_name,
            )

        if not matches and self.config.dry_run:
            return {
                "ok": True,
                "dry_run": True,
                "operation": "planned_lookup_and_delete_if_found",
                "cost_center_id": resolved_id,
                "cost_center_name": resolved_name,
                "verified_absent": False,
                "verification_status": "not_performed_dry_run",
            }
        if not matches:
            return {
                "ok": True,
                "dry_run": False,
                "operation": "no_budget_found",
                "cost_center_id": resolved_id,
                "cost_center_name": resolved_name,
                "verified_absent": True,
            }
        if len(matches) > 1:
            raise ValueError(
                f"Multiple bundled AI-credit budgets match cost center {resolved_name!r}; "
                "provide --budget-id to remove exactly one"
            )

        resolved_budget_id = str(matches[0].get("id") or "")
        response = self.delete_budget(resolved_budget_id)
        verified_absent = False
        if not self.config.dry_run:
            remaining = self.find_cost_center_budgets(
                cost_center_id=resolved_id,
                cost_center_name=resolved_name,
            )
            verified_absent = all(str(item.get("id") or "") != resolved_budget_id for item in remaining)
        return {
            "ok": self.config.dry_run or verified_absent,
            "dry_run": self.config.dry_run,
            "operation": "planned" if self.config.dry_run else "deleted",
            "cost_center_id": resolved_id,
            "cost_center_name": resolved_name,
            "budget_id": resolved_budget_id,
            "verified_absent": verified_absent,
            "verification_status": (
                "not_performed_dry_run"
                if self.config.dry_run
                else "verified"
                if verified_absent
                else "failed"
            ),
            "response": response if self.config.dry_run else None,
        }

    def monthly_budget_reset(
        self,
        *,
        baseline_file: str | None = None,
        prior_month_audit_file: str | None = None,
        reset_month: str | None = None,
        report_dir: str | None = None,
        confirmed: bool = False,
    ) -> dict[str, Any]:
        if bool(baseline_file) == bool(prior_month_audit_file):
            raise ValueError(
                "Provide exactly one of baseline_file or prior_month_audit_file"
            )
        if prior_month_audit_file and not reset_month:
            raise ValueError(
                "reset_month is required with prior_month_audit_file"
            )
        if baseline_file and reset_month:
            raise ValueError(
                "reset_month is only valid with prior_month_audit_file"
            )
        if self.config.dry_run:
            raise ValueError(
                "monthly-budget-reset performs a live read-only preflight when --yes "
                "is omitted; do not combine it with the global --dry-run option"
            )

        output_dir = self._monthly_reset_output_directory(report_dir)
        generated_at = datetime.now(timezone.utc)
        timestamp = generated_at.strftime("%Y%m%dT%H%M%S_%fZ")
        snapshot_path = output_dir / f"monthly_budget_reset_before_{timestamp}.json"
        audit_path = output_dir / f"monthly_budget_reset_audit_{timestamp}.json"

        source_kind = "baseline_file" if baseline_file else "prior_month_audit_file"

        report: dict[str, Any] = {
            "schema_version": MONTHLY_RESET_SCHEMA_VERSION,
            "operation": "monthly_budget_reset",
            "mode": "apply" if confirmed else "read_only_preflight",
            "status": "collecting",
            "generated_at_utc": generated_at.isoformat(),
            "enterprise": self.config.enterprise,
            "source": {
                "kind": source_kind,
                "path": baseline_file or prior_month_audit_file,
            },
            "snapshot_path": str(snapshot_path),
            "audit_report_path": str(audit_path),
            "filters": {
                "direct_user_budgets": {
                    "budget_scope": "user",
                    "budget_type": "BundlePricing",
                    "budget_product_sku": "ai_credits",
                },
                "cost_center_budgets": {
                    "budget_scope": "multi_user_cost_center",
                    "budget_type": "BundlePricing",
                    "budget_product_sku": "ai_credits",
                },
            },
            "preflight": {},
            "execution": {
                "cost_center_resets": [],
                "direct_user_budget_deletions": [],
            },
            "verification": {},
        }

        try:
            source = (
                self._load_monthly_reset_baseline_file(baseline_file or "")
                if baseline_file
                else self._load_monthly_reset_audit_file(
                    prior_month_audit_file or "",
                    reset_month=reset_month or "",
                )
            )
        except (OSError, ValueError, RuntimeError) as exc:
            report["status"] = "invalid_baseline_source"
            report["error"] = {
                "error_type": type(exc).__name__,
                "error": str(exc),
            }
            self._write_monthly_reset_json(audit_path, report)
            raise MonthlyBudgetResetError(
                "Unable to validate the monthly reset baseline source",
                audit_path,
            ) from exc
        report["source"] = {
            "kind": source["kind"],
            "path": source["path"],
            "sha256": source["sha256"],
            "period": source.get("period"),
            "reset_month": source.get("reset_month"),
            "collection_status": source.get("collection_status"),
        }

        try:
            budget_response = self.list_budgets(all_pages=True)
            all_budgets = [
                item
                for item in budget_response.get("budgets", [])
                if isinstance(item, dict)
            ]
            active_cost_centers = [
                item
                for item in extract_cost_centers(
                    self.list_cost_centers(state="active")
                )
                if isinstance(item, dict)
            ]
        except (GitHubApiError, ValueError, requests.RequestException, RuntimeError) as exc:
            report["status"] = "collection_failed"
            report["error"] = {
                "error_type": type(exc).__name__,
                "error": str(exc),
            }
            self._write_monthly_reset_json(audit_path, report)
            raise MonthlyBudgetResetError(
                "Unable to collect the current budget snapshot",
                audit_path,
            ) from exc

        snapshot = {
            "schema_version": MONTHLY_RESET_SCHEMA_VERSION,
            "snapshot_type": "monthly_budget_reset_before",
            "generated_at_utc": generated_at.isoformat(),
            "enterprise": self.config.enterprise,
            "budget_count": len(all_budgets),
            "active_cost_center_count": len(active_cost_centers),
            "budgets": all_budgets,
            "active_cost_centers": active_cost_centers,
        }
        self._write_monthly_reset_json(snapshot_path, snapshot)
        report["snapshot_sha256"] = hashlib.sha256(snapshot_path.read_bytes()).hexdigest()

        errors: list[dict[str, Any]] = []
        warnings: list[dict[str, Any]] = []
        centers: list[dict[str, str]] = []
        centers_by_id: dict[str, dict[str, str]] = {}
        centers_by_name: dict[str, dict[str, str]] = {}
        for index, item in enumerate(active_cost_centers):
            cost_center_id = str(item.get("id") or "").strip()
            cost_center_name = str(item.get("name") or "").strip()
            if not cost_center_id or not cost_center_name:
                errors.append(
                    {
                        "type": "InvalidCostCenter",
                        "message": (
                            f"Active cost center row {index} is missing id or name"
                        ),
                    }
                )
                continue
            normalized_name = cost_center_name.casefold()
            if cost_center_id in centers_by_id:
                errors.append(
                    {
                        "type": "DuplicateCostCenterId",
                        "cost_center_id": cost_center_id,
                    }
                )
                continue
            if normalized_name in centers_by_name:
                errors.append(
                    {
                        "type": "DuplicateCostCenterName",
                        "cost_center_name": cost_center_name,
                    }
                )
                continue
            center = {"id": cost_center_id, "name": cost_center_name}
            centers.append(center)
            centers_by_id[cost_center_id] = center
            centers_by_name[normalized_name] = center

        direct_user_budgets = [
            budget
            for budget in all_budgets
            if budget.get("budget_scope") == "user"
            and budget.get("budget_type") == "BundlePricing"
            and budget_has_sku(budget, "ai_credits")
        ]
        direct_user_groups: dict[str, list[dict[str, Any]]] = {}
        direct_user_deletions: list[dict[str, Any]] = []
        seen_budget_ids: set[str] = set()
        for budget in direct_user_budgets:
            budget_id = str(budget.get("id") or "").strip()
            login = str(
                first_present(
                    budget,
                    ("user", "budget_entity_name", "target_name"),
                    "",
                )
                or ""
            ).strip()
            normalized_login = normalize_login(login)
            if not budget_id or not normalized_login:
                errors.append(
                    {
                        "type": "InvalidDirectUserBudget",
                        "budget_id": budget_id or None,
                        "user": login or None,
                    }
                )
                continue
            if budget_id in seen_budget_ids:
                errors.append(
                    {
                        "type": "DuplicateBudgetId",
                        "budget_id": budget_id,
                    }
                )
                continue
            seen_budget_ids.add(budget_id)
            direct_user_groups.setdefault(normalized_login, []).append(budget)
            direct_user_deletions.append(
                {
                    "budget_id": budget_id,
                    "user": login,
                    "budget_amount": safe_float(budget.get("budget_amount")),
                }
            )
        for normalized_login, matches in sorted(direct_user_groups.items()):
            if len(matches) > 1:
                errors.append(
                    {
                        "type": "DuplicateDirectUserBudget",
                        "user": normalized_login,
                        "budget_ids": [str(item.get("id") or "") for item in matches],
                    }
                )

        cost_center_budgets = [
            budget
            for budget in all_budgets
            if budget.get("budget_scope") == "multi_user_cost_center"
            and budget.get("budget_type") == "BundlePricing"
            and budget_has_sku(budget, "ai_credits")
        ]
        cost_center_budget_by_center: dict[str, list[dict[str, Any]]] = {}
        cost_center_budget_by_id: dict[str, dict[str, Any]] = {}
        budget_center_by_id: dict[str, dict[str, str]] = {}
        for budget in cost_center_budgets:
            budget_id = str(budget.get("id") or "").strip()
            if not budget_id:
                errors.append(
                    {
                        "type": "InvalidCostCenterBudget",
                        "message": "A matching cost-center budget is missing its id",
                    }
                )
                continue
            if budget_id in seen_budget_ids:
                errors.append(
                    {
                        "type": "DuplicateBudgetId",
                        "budget_id": budget_id,
                    }
                )
                continue
            seen_budget_ids.add(budget_id)
            matches = [
                center
                for center in centers
                if budget_entity_matches(
                    budget,
                    cost_center_id=center["id"],
                    cost_center_name=center["name"],
                )
            ]
            if len(matches) != 1:
                errors.append(
                    {
                        "type": "UnresolvedCostCenterBudget",
                        "budget_id": budget_id,
                        "matched_cost_centers": [item["name"] for item in matches],
                    }
                )
                continue
            center = matches[0]
            cost_center_budget_by_id[budget_id] = budget
            budget_center_by_id[budget_id] = center
            cost_center_budget_by_center.setdefault(center["id"], []).append(budget)
        for cost_center_id, matches in sorted(cost_center_budget_by_center.items()):
            if len(matches) > 1:
                center = centers_by_id[cost_center_id]
                errors.append(
                    {
                        "type": "DuplicateCostCenterPerUserBudget",
                        "cost_center_id": cost_center_id,
                        "cost_center_name": center["name"],
                        "budget_ids": [str(item.get("id") or "") for item in matches],
                    }
                )
        if not cost_center_budgets:
            errors.append(
                {
                    "type": "NoCostCenterPerUserBudgets",
                    "message": (
                        "No multi_user_cost_center/BundlePricing/ai_credits budgets were found"
                    ),
                }
            )

        baseline_by_center: dict[str, dict[str, Any]] = {}
        if source["kind"] == "baseline_file":
            for row in source["rows"]:
                id_match = (
                    centers_by_id.get(row["cost_center_id"])
                    if row.get("cost_center_id")
                    else None
                )
                name_match = (
                    centers_by_name.get(str(row["cost_center_name"]).casefold())
                    if row.get("cost_center_name")
                    else None
                )
                if (
                    row.get("cost_center_id")
                    and row.get("cost_center_name")
                    and (not id_match or not name_match)
                ):
                    errors.append(
                        {
                            "type": "BaselineIdentityNotFound",
                            "cost_center_id": row.get("cost_center_id"),
                            "cost_center_name": row.get("cost_center_name"),
                        }
                    )
                    continue
                if id_match and name_match and id_match["id"] != name_match["id"]:
                    errors.append(
                        {
                            "type": "BaselineIdentityConflict",
                            "cost_center_id": row.get("cost_center_id"),
                            "cost_center_name": row.get("cost_center_name"),
                        }
                    )
                    continue
                center = id_match or name_match
                if not center:
                    warnings.append(
                        {
                            "type": "UnusedBaseline",
                            "cost_center_id": row.get("cost_center_id"),
                            "cost_center_name": row.get("cost_center_name"),
                        }
                    )
                    continue
                if center["id"] in baseline_by_center:
                    errors.append(
                        {
                            "type": "DuplicateResolvedBaseline",
                            "cost_center_id": center["id"],
                            "cost_center_name": center["name"],
                        }
                    )
                    continue
                baseline_by_center[center["id"]] = {
                    "initial_budget_amount": row["initial_budget_amount"],
                    "baseline_source": "baseline_file",
                }
        else:
            events_by_budget_id: dict[str, list[dict[str, Any]]] = {}
            current_budget_ids = set(budget_center_by_id)
            for event in source["events"]:
                events_by_budget_id.setdefault(event["budget_id"], []).append(event)
                if event["budget_id"] not in current_budget_ids:
                    warnings.append(
                        {
                            "type": "AuditEventForNonCurrentBudget",
                            "budget_id": event["budget_id"],
                            "action": event["action"],
                            "timestamp": event["timestamp"],
                        }
                    )
            for budget_id, center in sorted(
                budget_center_by_id.items(),
                key=lambda item: item[1]["name"].casefold(),
            ):
                budget = cost_center_budget_by_id[budget_id]
                try:
                    current_amount = self._monthly_reset_amount(
                        budget.get("budget_amount"),
                        f"budget {budget_id} budget_amount",
                    )
                except ValueError as exc:
                    errors.append(
                        {
                            "type": "InvalidCurrentBudgetAmount",
                            "budget_id": budget_id,
                            "cost_center_name": center["name"],
                            "message": str(exc),
                        }
                    )
                    continue
                events = sorted(
                    events_by_budget_id.get(budget_id, []),
                    key=lambda item: (item["timestamp"], item["action"]),
                )
                if not events:
                    baseline_by_center[center["id"]] = {
                        "initial_budget_amount": current_amount,
                        "baseline_source": "unchanged_in_prior_month_audit",
                    }
                    continue
                if any(event["action"] == "billing.budget_delete" for event in events):
                    errors.append(
                        {
                            "type": "DeletedBudgetInAuditHistory",
                            "budget_id": budget_id,
                            "cost_center_name": center["name"],
                        }
                    )
                    continue
                create_events = [
                    event
                    for event in events
                    if event["action"] == "billing.budget_create"
                ]
                if len(create_events) > 1:
                    errors.append(
                        {
                            "type": "DuplicateBudgetCreateEvents",
                            "budget_id": budget_id,
                            "cost_center_name": center["name"],
                        }
                    )
                    continue

                if create_events:
                    if events[0]["action"] != "billing.budget_create":
                        errors.append(
                            {
                                "type": "NonContiguousAuditHistory",
                                "budget_id": budget_id,
                                "cost_center_name": center["name"],
                                "message": "budget_create is not the first event",
                            }
                        )
                        continue
                    initial_amount = int(events[0]["target_amount"])
                    replay_amount = initial_amount
                    replay_events = events[1:]
                else:
                    first_event = events[0]
                    if first_event["action"] != "billing.budget_update":
                        errors.append(
                            {
                                "type": "NonContiguousAuditHistory",
                                "budget_id": budget_id,
                                "cost_center_name": center["name"],
                                "message": "first event does not provide an old target amount",
                            }
                        )
                        continue
                    initial_amount = int(first_event["old_target_amount"])
                    replay_amount = initial_amount
                    replay_events = events

                replay_failed = False
                for event in replay_events:
                    if event["action"] != "billing.budget_update":
                        errors.append(
                            {
                                "type": "NonContiguousAuditHistory",
                                "budget_id": budget_id,
                                "cost_center_name": center["name"],
                                "message": f"unexpected {event['action']} event",
                            }
                        )
                        replay_failed = True
                        break
                    if int(event["old_target_amount"]) != replay_amount:
                        errors.append(
                            {
                                "type": "NonContiguousAuditHistory",
                                "budget_id": budget_id,
                                "cost_center_name": center["name"],
                                "expected_old_target_amount": replay_amount,
                                "actual_old_target_amount": event["old_target_amount"],
                                "timestamp": event["timestamp"],
                            }
                        )
                        replay_failed = True
                        break
                    replay_amount = int(event["target_amount"])
                if replay_failed:
                    continue
                if replay_amount != current_amount:
                    errors.append(
                        {
                            "type": "AuditHistoryCurrentAmountMismatch",
                            "budget_id": budget_id,
                            "cost_center_name": center["name"],
                            "audit_replayed_amount": replay_amount,
                            "current_budget_amount": current_amount,
                        }
                    )
                    continue
                baseline_by_center[center["id"]] = {
                    "initial_budget_amount": initial_amount,
                    "baseline_source": "prior_month_audit_replay",
                }

        reset_plan: list[dict[str, Any]] = []
        for cost_center_id, matches in sorted(
            cost_center_budget_by_center.items(),
            key=lambda item: centers_by_id[item[0]]["name"].casefold(),
        ):
            if len(matches) != 1:
                continue
            budget = matches[0]
            center = centers_by_id[cost_center_id]
            budget_id = str(budget.get("id") or "")
            baseline = baseline_by_center.get(cost_center_id)
            if not baseline:
                errors.append(
                    {
                        "type": "MissingBaseline",
                        "budget_id": budget_id,
                        "cost_center_id": cost_center_id,
                        "cost_center_name": center["name"],
                    }
                )
                continue
            try:
                current_amount = self._monthly_reset_amount(
                    budget.get("budget_amount"),
                    f"budget {budget_id} budget_amount",
                )
            except ValueError as exc:
                errors.append(
                    {
                        "type": "InvalidCurrentBudgetAmount",
                        "budget_id": budget_id,
                        "cost_center_name": center["name"],
                        "message": str(exc),
                    }
                )
                continue
            initial_amount = int(baseline["initial_budget_amount"])
            alerting = budget.get("budget_alerting")
            if not isinstance(alerting, dict):
                alerting = {}
            policy_matches = (
                budget.get("prevent_further_usage") is True
                and alerting.get("will_alert") is False
                and not (alerting.get("alert_recipients") or [])
            )
            reset_plan.append(
                {
                    "budget_id": budget_id,
                    "cost_center_id": cost_center_id,
                    "cost_center_name": center["name"],
                    "current_budget_amount": current_amount,
                    "initial_budget_amount": initial_amount,
                    "additional_budget_amount": max(current_amount - initial_amount, 0),
                    "budget_reduction_amount": max(initial_amount - current_amount, 0),
                    "baseline_source": baseline["baseline_source"],
                    "needs_update": current_amount != initial_amount or not policy_matches,
                }
            )

        direct_user_deletions.sort(
            key=lambda item: (str(item["user"]).casefold(), item["budget_id"])
        )
        report["preflight"] = {
            "total_current_budgets": len(all_budgets),
            "active_cost_centers": len(centers),
            "direct_user_budgets_to_delete": len(direct_user_deletions),
            "cost_center_per_user_budgets_to_verify": len(reset_plan),
            "cost_center_per_user_budgets_to_patch": sum(
                1 for item in reset_plan if item["needs_update"]
            ),
            "direct_user_budget_deletions": direct_user_deletions,
            "cost_center_reset_plan": reset_plan,
            "errors": errors,
            "warnings": warnings,
        }

        if errors:
            report["status"] = "blocked_preflight"
            self._write_monthly_reset_json(audit_path, report)
            raise MonthlyBudgetResetError(
                f"Monthly reset preflight found {len(errors)} blocking error(s)",
                audit_path,
            )

        if not confirmed:
            report["status"] = "planned_no_changes"
            report["completed_at_utc"] = datetime.now(timezone.utc).isoformat()
            self._write_monthly_reset_json(audit_path, report)
            return {
                "ok": True,
                "dry_run": False,
                "operation": "planned_no_changes",
                "snapshot_path": str(snapshot_path),
                "audit_report_path": str(audit_path),
                "direct_user_budgets_to_delete": len(direct_user_deletions),
                "cost_center_budgets_to_patch": sum(
                    1 for item in reset_plan if item["needs_update"]
                ),
                "cost_center_budgets_to_verify": len(reset_plan),
                "apply_command_requires_yes": True,
            }

        reset_results: list[dict[str, Any]] = []
        for plan in reset_plan:
            try:
                current = unwrap_budget(self.get_budget(plan["budget_id"]))
                precondition_matches = (
                    current.get("budget_scope") == "multi_user_cost_center"
                    and current.get("budget_type") == "BundlePricing"
                    and budget_has_sku(current, "ai_credits")
                    and budget_entity_matches(
                        current,
                        cost_center_id=plan["cost_center_id"],
                        cost_center_name=plan["cost_center_name"],
                    )
                    and safe_float(current.get("budget_amount"))
                    == float(plan["current_budget_amount"])
                )
                if not precondition_matches:
                    reset_results.append(
                        {
                            "budget_id": plan["budget_id"],
                            "cost_center_id": plan["cost_center_id"],
                            "cost_center_name": plan["cost_center_name"],
                            "status": "precondition_failed",
                            "message": "Budget changed or no longer matches the reset target",
                        }
                    )
                    continue
            except (GitHubApiError, ValueError, requests.RequestException, RuntimeError) as exc:
                reset_results.append(
                    {
                        "budget_id": plan["budget_id"],
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "status": "precondition_read_failed",
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )
                continue
            if not plan["needs_update"]:
                reset_results.append(
                    {
                        "budget_id": plan["budget_id"],
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "status": "already_at_baseline",
                    }
                )
                continue
            try:
                self.update_budget(
                    plan["budget_id"],
                    {
                        "budget_amount": plan["initial_budget_amount"],
                        "prevent_further_usage": True,
                        "budget_alerting": {
                            "will_alert": False,
                            "alert_recipients": [],
                        },
                    },
                )
                reset_results.append(
                    {
                        "budget_id": plan["budget_id"],
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "status": "patch_sent",
                    }
                )
            except (GitHubApiError, ValueError, requests.RequestException, RuntimeError) as exc:
                reset_results.append(
                    {
                        "budget_id": plan["budget_id"],
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "status": "patch_failed",
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        reset_verification: list[dict[str, Any]] = []
        reset_plan_by_id = {item["budget_id"]: item for item in reset_plan}
        for budget_id, plan in reset_plan_by_id.items():
            try:
                readback = unwrap_budget(self.get_budget(budget_id))
                alerting = readback.get("budget_alerting")
                if not isinstance(alerting, dict):
                    alerting = {}
                verified = (
                    readback.get("budget_scope") == "multi_user_cost_center"
                    and readback.get("budget_type") == "BundlePricing"
                    and budget_has_sku(readback, "ai_credits")
                    and budget_entity_matches(
                        readback,
                        cost_center_id=plan["cost_center_id"],
                        cost_center_name=plan["cost_center_name"],
                    )
                    and safe_float(readback.get("budget_amount"))
                    == float(plan["initial_budget_amount"])
                    and readback.get("prevent_further_usage") is True
                    and alerting.get("will_alert") is False
                    and not (alerting.get("alert_recipients") or [])
                )
                reset_verification.append(
                    {
                        "budget_id": budget_id,
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "expected_budget_amount": plan["initial_budget_amount"],
                        "actual_budget_amount": safe_float(readback.get("budget_amount")),
                        "verified": verified,
                    }
                )
            except (GitHubApiError, ValueError, requests.RequestException, RuntimeError) as exc:
                reset_verification.append(
                    {
                        "budget_id": budget_id,
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "expected_budget_amount": plan["initial_budget_amount"],
                        "verified": False,
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        report["execution"]["cost_center_resets"] = reset_results
        report["verification"]["cost_center_resets"] = reset_verification
        if not all(item.get("verified") is True for item in reset_verification):
            report["status"] = "failed_before_user_budget_deletion"
            report["completed_at_utc"] = datetime.now(timezone.utc).isoformat()
            self._write_monthly_reset_json(audit_path, report)
            raise MonthlyBudgetResetError(
                "One or more cost-center resets could not be verified; no direct user "
                "budget deletion was attempted",
                audit_path,
            )

        deletion_results: list[dict[str, Any]] = []
        for planned in direct_user_deletions:
            try:
                current = unwrap_budget(self.get_budget(planned["budget_id"]))
                current_user = str(
                    first_present(
                        current,
                        ("user", "budget_entity_name", "target_name"),
                        "",
                    )
                    or ""
                )
                precondition_matches = (
                    current.get("budget_scope") == "user"
                    and current.get("budget_type") == "BundlePricing"
                    and budget_has_sku(current, "ai_credits")
                    and normalize_login(current_user)
                    == normalize_login(str(planned["user"]))
                    and safe_float(current.get("budget_amount"))
                    == safe_float(planned.get("budget_amount"))
                )
                if not precondition_matches:
                    deletion_results.append(
                        {
                            "budget_id": planned["budget_id"],
                            "user": planned["user"],
                            "status": "precondition_failed",
                            "message": "Budget changed or no longer matches the deletion target",
                        }
                    )
                    continue
                self.delete_budget(planned["budget_id"])
                deletion_results.append(
                    {
                        "budget_id": planned["budget_id"],
                        "user": planned["user"],
                        "status": "delete_sent",
                    }
                )
            except GitHubApiError as exc:
                deletion_results.append(
                    {
                        "budget_id": planned["budget_id"],
                        "user": planned["user"],
                        "status": (
                            "already_absent_before_delete"
                            if exc.status_code == 404
                            else "delete_failed"
                        ),
                        "error_type": None if exc.status_code == 404 else type(exc).__name__,
                        "error": None if exc.status_code == 404 else str(exc),
                    }
                )
            except (ValueError, requests.RequestException, RuntimeError) as exc:
                deletion_results.append(
                    {
                        "budget_id": planned["budget_id"],
                        "user": planned["user"],
                        "status": "delete_failed",
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        deletion_verification: list[dict[str, Any]] = []
        for planned in direct_user_deletions:
            try:
                readback = unwrap_budget(self.get_budget(planned["budget_id"]))
                deletion_verification.append(
                    {
                        "budget_id": planned["budget_id"],
                        "user": planned["user"],
                        "verified_absent": False,
                        "readback_scope": readback.get("budget_scope"),
                    }
                )
            except GitHubApiError as exc:
                deletion_verification.append(
                    {
                        "budget_id": planned["budget_id"],
                        "user": planned["user"],
                        "verified_absent": exc.status_code == 404,
                        "readback_status": exc.status_code,
                        "error": None if exc.status_code == 404 else str(exc),
                    }
                )
            except (ValueError, requests.RequestException, RuntimeError) as exc:
                deletion_verification.append(
                    {
                        "budget_id": planned["budget_id"],
                        "user": planned["user"],
                        "verified_absent": False,
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        final_budget_error: dict[str, Any] | None = None
        final_direct_user_budgets: list[dict[str, Any]] = []
        try:
            final_budget_response = self.list_budgets(all_pages=True)
            final_budget_items = [
                item
                for item in final_budget_response.get("budgets", [])
                if isinstance(item, dict)
            ]
            final_direct_user_budgets = [
                {
                    "budget_id": str(item.get("id") or ""),
                    "user": str(
                        first_present(
                            item,
                            ("user", "budget_entity_name", "target_name"),
                            "",
                        )
                        or ""
                    ),
                }
                for item in final_budget_items
                if item.get("budget_scope") == "user"
                and item.get("budget_type") == "BundlePricing"
                and budget_has_sku(item, "ai_credits")
            ]
        except (GitHubApiError, ValueError, requests.RequestException, RuntimeError) as exc:
            final_budget_error = {
                "error_type": type(exc).__name__,
                "error": str(exc),
            }

        final_reset_verification: list[dict[str, Any]] = []
        for budget_id, plan in reset_plan_by_id.items():
            try:
                readback = unwrap_budget(self.get_budget(budget_id))
                alerting = readback.get("budget_alerting")
                if not isinstance(alerting, dict):
                    alerting = {}
                verified = (
                    readback.get("budget_scope") == "multi_user_cost_center"
                    and readback.get("budget_type") == "BundlePricing"
                    and budget_has_sku(readback, "ai_credits")
                    and budget_entity_matches(
                        readback,
                        cost_center_id=plan["cost_center_id"],
                        cost_center_name=plan["cost_center_name"],
                    )
                    and safe_float(readback.get("budget_amount"))
                    == float(plan["initial_budget_amount"])
                    and readback.get("prevent_further_usage") is True
                    and alerting.get("will_alert") is False
                    and not (alerting.get("alert_recipients") or [])
                )
                final_reset_verification.append(
                    {
                        "budget_id": budget_id,
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "expected_budget_amount": plan["initial_budget_amount"],
                        "actual_budget_amount": safe_float(readback.get("budget_amount")),
                        "verified": verified,
                    }
                )
            except (GitHubApiError, ValueError, requests.RequestException, RuntimeError) as exc:
                final_reset_verification.append(
                    {
                        "budget_id": budget_id,
                        "cost_center_id": plan["cost_center_id"],
                        "cost_center_name": plan["cost_center_name"],
                        "expected_budget_amount": plan["initial_budget_amount"],
                        "verified": False,
                        "error_type": type(exc).__name__,
                        "error": str(exc),
                    }
                )

        deletions_verified = all(
            item.get("verified_absent") is True for item in deletion_verification
        )
        reset_verified = all(
            item.get("verified") is True for item in final_reset_verification
        )
        list_verified_empty = final_budget_error is None and not final_direct_user_budgets
        completed = deletions_verified and reset_verified and list_verified_empty
        report["execution"]["direct_user_budget_deletions"] = deletion_results
        report["verification"].update(
            {
                "direct_user_budget_deletions": deletion_verification,
                "final_direct_user_budget_list_empty": list_verified_empty,
                "final_direct_user_budgets": final_direct_user_budgets,
                "final_budget_list_error": final_budget_error,
                "final_cost_center_resets": final_reset_verification,
            }
        )
        report["status"] = "completed_verified" if completed else "failed_after_mutation"
        report["completed_at_utc"] = datetime.now(timezone.utc).isoformat()
        self._write_monthly_reset_json(audit_path, report)
        if not completed:
            raise MonthlyBudgetResetError(
                "Monthly reset finished with one or more unverified outcomes",
                audit_path,
            )
        return {
            "ok": True,
            "dry_run": False,
            "operation": "completed_verified",
            "snapshot_path": str(snapshot_path),
            "audit_report_path": str(audit_path),
            "direct_user_budgets_deleted": len(direct_user_deletions),
            "cost_center_budgets_reset": sum(
                1 for item in reset_plan if item["needs_update"]
            ),
            "cost_center_budgets_verified": len(final_reset_verification),
        }

